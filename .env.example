# --- Veritabanı ---
DATABASE_URL=postgresql://nomosos:nomosos@localhost:5432/nomosos

# --- Redis (kuyruk / önbellek) ---
REDIS_URL=redis://localhost:6379

# --- Belge deposu (MinIO / S3 uyumlu) ---
# Belge yükleme, dilekçe UDF dışa aktarımı ve ön-imzalı indirme bağlantıları
# bu ayarları kullanır. S3_ENDPOINT tanımsızsa API yine açılır; belge yükleme
# ucu hata döner, dilekçe dışa aktarımı base64 gövdeye (INLINE) düşer.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nomosos
S3_SECRET_KEY=nomosos-gizli-123
S3_BUCKET=nomosos-belgeler
# MinIO için bölge anlamsızdır; AWS S3 kullanılacaksa gerçek bölge yazılmalıdır.
S3_REGION=us-east-1

# --- API ---
API_PORT=3001
# EN AZ 32 KARAKTER olmalıdır; kısa anahtarla uygulama AÇILMAZ.
JWT_SECRET=degistir-uzun-rastgele-bir-deger-koy

# AI sağlayıcı API anahtarlarını şifrelemek için 32 baytlık hex anahtar.
# Üretmek için: openssl rand -hex 32  (veya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MASTER_ENCRYPTION_KEY=

# --- AI Asistanı: RAG gömme (embedding) modeli ---
# Belge parçalarının vektörlenmesinde kullanılır. Boş bırakılırsa sağlayıcı
# tipine göre varsayılan seçilir (OPENAI_COMPAT: text-embedding-3-small,
# OLLAMA: nomic-embed-text). Gömme desteklenmeyen sağlayıcıda (ANTHROPIC,
# GEMINI, CUSTOM) asistan otomatik olarak anahtar kelime aramasına düşer.
# Tipe özel değişken geneli ezer: AI_EMBEDDING_MODEL_<TİP>
AI_EMBEDDING_MODEL=
# AI_EMBEDDING_MODEL_OPENAI_COMPAT=text-embedding-3-small
# AI_EMBEDDING_MODEL_OLLAMA=nomic-embed-text

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# =====================================================================
# Faz 2 denetim düzeltmeleriyle gelen ayarlar
# =====================================================================

# --- AI çağrılarında zaman aşımı (ms) ---
# Node fetch'inde VARSAYILAN İSTEK ZAMAN AŞIMI YOKTUR. Sağlayıcı yanıt vermezse
# belge yükleme isteği süresiz asılı kalır ve 50 MB'lık tampon bellekte tutulur.
# Alt sınır 5 sn, üst sınır 600 sn.
AI_TIMEOUT_MS=60000

# --- Büro-içi kabul edilecek EK ana makineler (virgülle ayrılmış) ---
# KVKK dışsallık kararı sağlayıcı TİPİNE değil ADRESE bakılarak verilir:
# localhost, 127.x, 10.x, 172.16-31.x, 192.168.x ve *.local zaten büro içidir.
# Kendi alan adınızla çalışan büro-içi bir LLM varsa buraya ekleyin.
# AI_INTERNAL_HOSTS=llm.buro.local,gpu01

# --- Pahalı AI uçlarında hız sınırı (kullanıcı + uç başına) ---
# BYO-LLM maliyeti doğrudan büroya yazıldığı için sınır ürünün parçasıdır.
# Aşıldığında HTTP 429 + Türkçe açıklama döner.
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_DAY=300

# --- Yükleme ve ayrıştırma sınırları ---
# Tek PDF'te ayrıştırılacak azami sayfa; aşılırsa KISMİ metin + açık uyarı.
MAX_PDF_PAGES=300
# JSON gövde tavanı (belge yüklemesi multipart'tır, bu sınıra takılmaz).
API_JSON_BODY_LIMIT=1mb
# TLS sonlandırma ters vekilde ise HSTS başlığını açar.
API_FORCE_HSTS=false
