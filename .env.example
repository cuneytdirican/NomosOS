# --- Veritabanı ---
DATABASE_URL=postgresql://nomosos:nomosos@localhost:5432/nomosos

# --- Redis (kuyruk / önbellek) ---
REDIS_URL=redis://localhost:6379

# --- Video arama ICE sunucuları (D5) ---
# STUN boşsa genel Google STUN kullanılır (varsayılan davranış).
# TURN yalnız ÜÇÜ BİRLİKTE tanımlıysa devreye girer (STUN URL'siz kimlik yok sayılır):
# TURN_URLS=turn:turn.ornek.local:3478?transport=udp
# TURN_USERNAME=
# TURN_CREDENTIAL=
STUN_URLS=

# --- Belge deposu (MinIO / S3 uyumlu) ---
# Belge yükleme, dilekçe UDF dışa aktarımı ve ön-imzalı indirme bağlantıları
# bu ayarları kullanır. S3_ENDPOINT tanımsızsa API yine açılır; belge yükleme
# ucu hata döner, dilekçe dışa aktarımı base64 gövdeye (INLINE) düşer.
# ÜRETİM (NODE_ENV=production): S3_ACCESS_KEY / S3_SECRET_KEY / S3_BUCKET
# ZORUNLUDUR — eksikse API AÇILIŞTA DÜŞER (İ-15: gömülü geliştirme varsayılanları
# üretimde kullanılamaz).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nomosos
S3_SECRET_KEY=nomosos-gizli-123
S3_BUCKET=nomosos-belgeler
# MinIO için bölge anlamsızdır; AWS S3 kullanılacaksa gerçek bölge yazılmalıdır.
S3_REGION=us-east-1

# --- API ---
API_PORT=3001
# EN AZ 32 KARAKTER olmalıdır; kısa anahtarla uygulama AÇILMAZ.
JWT_SECRET=degistir-uzun-rastgele-bir-deger-koy

# CORS BEYAZ LİSTESİ (virgüllü). Tanımsızsa varsayılan http://localhost:3000'dir;
# üretimde tarayıcı istekleri CORS'a takılır (bkz. docs/uretim-dagitimi.md §3.1).
WEB_ORIGIN=

# Üretimde zorunlu: ters vekil arkasındaysanız hop sayısı (genellikle 1),
# doğrudan internete açıksanız AÇIKÇA 0. Tanımsız/bozuksa API AÇILMAZ
# (bkz. docs/uretim-dagitimi.md §3.2.1).
TRUSTED_PROXY_HOPS=0

# AI sağlayıcı API anahtarlarını şifrelemek için 32 baytlık hex anahtar.
# Üretmek için: openssl rand -hex 32  (veya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MASTER_ENCRYPTION_KEY=

# --- AI Asistanı: RAG gömme (embedding) modeli ---
# Belge parçalarının vektörlenmesinde kullanılır. Boş bırakılırsa sağlayıcı
# tipine göre varsayılan seçilir (OPENAI_COMPAT: text-embedding-3-small,
# OLLAMA: nomic-embed-text). Gömme desteklenmeyen sağlayıcıda (ANTHROPIC,
# GEMINI, CUSTOM) asistan otomatik olarak anahtar kelime aramasına düşer.
# Tipe özel değişken geneli ezer: AI_EMBEDDING_MODEL_<TİP>
AI_EMBEDDING_MODEL=
# AI_EMBEDDING_MODEL_OPENAI_COMPAT=text-embedding-3-small
# AI_EMBEDDING_MODEL_OLLAMA=nomic-embed-text

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# =====================================================================
# Faz 2 denetim düzeltmeleriyle gelen ayarlar
# =====================================================================

# --- AI çağrılarında zaman aşımı (ms) ---
# Node fetch'inde VARSAYILAN İSTEK ZAMAN AŞIMI YOKTUR. Sağlayıcı yanıt vermezse
# belge yükleme isteği süresiz asılı kalır ve 50 MB'lık tampon bellekte tutulur.
# Alt sınır 5 sn, üst sınır 600 sn.
AI_TIMEOUT_MS=60000

# --- Büro-içi kabul edilecek EK ana makineler (virgülle ayrılmış) ---
# KVKK dışsallık kararı sağlayıcı TİPİNE değil ADRESE bakılarak verilir:
# localhost, 127.x, 10.x, 172.16-31.x, 192.168.x ve *.local zaten büro içidir.
# Kendi alan adınızla çalışan büro-içi bir LLM varsa buraya ekleyin.
# AI_INTERNAL_HOSTS=llm.buro.local,gpu01

# --- Pahalı AI uçlarında hız sınırı ---
# BYO-LLM maliyeti doğrudan büroya yazıldığı için sınır ürünün parçasıdır.
# Aşıldığında HTTP 429 + Türkçe açıklama döner.
#
# İKİ KATLI (denetim bulgusu Ö-10): alttaki iki değer KULLANICI + UÇ başına,
# üstteki iki değer BÜRO (kiracı) başına ve UÇTAN BAĞIMSIZ işler. Yalnız
# kullanıcı bazlı sınır, 10 kullanıcılı bir büroda uç sayısıyla da çarpılıp
# günde on binlerce çağrıya izin veriyordu; büro tavanı bunu keser.
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_DAY=300
AI_RATE_LIMIT_TENANT_PER_MINUTE=60
AI_RATE_LIMIT_TENANT_PER_DAY=2000

# --- Oran sınırı sayacının yeri (denetim bulgusu Ö-09) ---
# auto (varsayılan) = REDIS_URL varsa Redis, yoksa süreç-içi bellek
# memory           = her koşulda süreç-içi (tek örnekli kurulum, testler)
# redis            = zorunlu Redis; REDIS_URL yoksa uygulama AÇILMAZ
# ÇOK ÖRNEKLİ (replicas > 1) DAĞITIMDA "redis" YAZIN: süreç-içi sayaç her
# örnekte ayrı tutulur ve bütün sınırlar örnek sayısıyla ÇARPILIR.
RATE_LIMIT_BACKEND=auto

# --- Yükleme ve ayrıştırma sınırları ---
# Tek PDF'te ayrıştırılacak azami sayfa; aşılırsa KISMİ metin + açık uyarı.
MAX_PDF_PAGES=300
# JSON gövde tavanı (belge yüklemesi multipart'tır, bu sınıra takılmaz).
API_JSON_BODY_LIMIT=1mb
# TLS sonlandırma ters vekilde ise HSTS başlığını açar.
API_FORCE_HSTS=false

# =====================================================================
# Faz 3 — İcra, Finans, Faturalama, Platform Yönetim Paneli
# =====================================================================

# --- Faturalama (Modül 09) ---
# Varsayılan KDV oranı (%). Ücret sözleşmesinde (FeeAgreement.vatRate) oran
# tanımlıysa O kullanılır; bu değer yalnızca sözleşmesiz kalemler içindir.
# Oran koda GÖMÜLÜ DEĞİLDİR: mevzuat değişirse burada değişir.
DEFAULT_VAT_RATE=20
# Fatura numarası öneki. Numara UBL-TR 1.2 biçimindedir: <ÖNEK><YIL><9 hane>
# (ör. NOM2026000000001). Ardışıklık veritabanı kilidiyle garanti edilir.
INVOICE_NUMBER_PREFIX=NOM
# e-Fatura entegratörü. Varsayılan "noop" GİB'e HİÇBİR bağlantı kurmaz ve
# gönderim isteğinde 503 + Türkçe açıklama döner; faturanın hiçbir alanını
# değiştirmez (sahte "gönderildi" durumu üretilmez). Gerçek entegratör
# eklendiğinde bu değer onun anahtarına çekilir.
EINVOICE_PROVIDER=noop

# --- Platform yönetim paneli (Modül 25) ---
# Panel token'ı KİRACI token'ından FARKLI bir anahtarla imzalanır. Bu değişken
# tanımsızsa anahtar JWT_SECRET'ten HMAC-SHA256 ile TÜRETİLİR (tek yönlü;
# birinden diğeri elde edilemez), yani zorunlu değildir. Tanımlanacaksa EN AZ
# 32 KARAKTER olmalıdır.
# PLATFORM_JWT_SECRET=
# Panel girişinde iki adımlı doğrulama (TOTP) zorunlu mu?
# ÜRETİMDE "true" OLMAK ZORUNDADIR — artık yorumla değil KODLA zorlanır:
# NODE_ENV=production iken bu değer "true" değilse UYGULAMA AÇILMAZ
# (assertTwoFactorPolicy, main.ts). false iken 2FA kurmuş kullanıcı yine iki
# adımla girer; kurmamış kullanıcı tek adımda token alır (geliştirme kolaylığı).
PLATFORM_REQUIRE_2FA=false

# Panel 2FA (TOTP) gizli anahtarlarını şifreleyen anahtar — 64 hane hex.
# NEDEN AYRI: spec §Güvenlik 7 gereği MASTER_ENCRYPTION_KEY panel yolunda
# KULLANILMAMALIDIR; o anahtar tüm kiracıların LLM sağlayıcı anahtarlarını da
# çözer. Tanımsızsa anahtar MASTER_ENCRYPTION_KEY'den HMAC-SHA256 ile TÜRETİLİR
# (tek yönlü): türetilmiş anahtarla şifrelenen TOTP kayıtları master anahtarla
# çözülemez. Değiştirilirse mevcut 2FA kayıtları OKUNAMAZ ve sıfırlanmaları
# gerekir.
# PLATFORM_2FA_ENCRYPTION_KEY=

# --- Ters vekil (reverse proxy) ---
# Önünüzde kaç güvenilen vekil var? 0 = "vekil yok, X-Forwarded-For başlığına
# HİÇ BAKMA". Ayar olmadan başlık istemci tarafından uydurulabilir ve 10 yıl
# saklanan denetim izindeki IP alanı sahtelenebilir hâle gelir.
# Nginx/Caddy/Traefik/ALB arkasındaysanız hop sayısını AÇIKÇA yazın (genellikle 1).
#
# ÜRETİMDE ZORUNLUDUR (denetim bulgusu Ö-08): NODE_ENV=production iken bu
# değişken tanımsızsa ya da geçersizse API AÇILMAZ. Eskiden hem tanımsız hem
# bozuk değer sessizce 0'a düşüyordu; vekil arkasında bu, hesap kilidini
# (herkes tek IP görünür), oran sınırını ve denetim izindeki IP alanını
# birlikte çürütüyordu — hiçbir uyarı üretmeden.
TRUSTED_PROXY_HOPS=0

# --- Admin paneli (apps/admin) ---
# Panel, platform API'sini /api/admin/v1 önekinden çağırır. Kiracı API'si
# /api/v1'dedir; iki adres uzayı bilinçli olarak ayrıdır.
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001
