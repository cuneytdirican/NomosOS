{
  "name": "nomosos",
  "private": true,
  "version": "0.1.0",
  "description": "NomosOS — AI-Native Legal Operating System (Türk hukuk büroları için)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings 0",
    "db:generate": "pnpm --filter @nomosos/db generate",
    "db:migrate": "pnpm --filter @nomosos/db migrate:dev",
    "db:deploy": "pnpm --filter @nomosos/db migrate:deploy",
    "db:seed": "pnpm --filter @nomosos/db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.19.0"
  }
}
