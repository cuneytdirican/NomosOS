# =============================================================================
# NomosOS — ÜRETİM ortam değişkenleri (docker-compose.prod.yml için)
# =============================================================================
#
# KULLANIM
#   cp docker-compose.prod.env.example .env.prod.local
#   chmod 600 .env.prod.local              # yalnız sunucu sahibi okusun
#   # değerleri doldurun, sonra:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod.local up -d
#
# DOSYA ADI NEDEN ".env.prod.local"?
# Kökteki .gitignore `.env`, `.env.local` ve `.env.*.local` kalıplarını yok
# sayar — ama DÜZ `.env.prod` ADINI YOK SAYMAZ. ".local" son ekiyle dosya
# kendiliğinden sürüm kontrolünün dışında kalır. Başka bir ad kullanacaksanız
# ÖNCE .gitignore'a ekleyin; yoksa üretim sırlarını depoya işleme riski vardır.
# (Docker tarafında risk yoktur: .dockerignore tüm `.env*` dosyalarını eler,
# dolayısıyla sırlar imaj katmanına hiçbir hâlde girmez.)
#
# Betikler de bu adı varsayar:
#   ENV_FILE=.env.prod.local  (scripts/prod-migrate.sh, scripts/prod-backup.sh)
#
# Bu dosyadaki değişkenlerin çoğu docker-compose.prod.yml içinde
# `${DEĞİŞKEN:?...}` biçimindedir: boş bırakırsanız yığın AÇILMAZ, sessizce
# geliştirme varsayılanına düşmez. Bu bilinçli bir tasarımdır.
#
#
# -----------------------------------------------------------------------------
# ANAHTAR ÜRETME KOMUTLARI (hepsi tek seferde)
# -----------------------------------------------------------------------------
# Linux / macOS / Windows Git Bash:
#
#   echo "POSTGRES_PASSWORD=$(openssl rand -base64 36 | tr -d '\n/+=' | cut -c1-40)"
#   echo "REDIS_PASSWORD=$(openssl rand -base64 36 | tr -d '\n/+=' | cut -c1-40)"
#   echo "MINIO_ROOT_PASSWORD=$(openssl rand -base64 36 | tr -d '\n/+=' | cut -c1-40)"
#   echo "JWT_SECRET=$(openssl rand -base64 48 | tr -d '\n')"
#   echo "PLATFORM_JWT_SECRET=$(openssl rand -base64 48 | tr -d '\n')"
#   echo "MASTER_ENCRYPTION_KEY=$(openssl rand -hex 32)"
#   echo "PLATFORM_2FA_ENCRYPTION_KEY=$(openssl rand -hex 32)"
#
# openssl yoksa (Node 22 her sunucuda var):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"   # JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"      # 64 hane hex
#
# Not: parolalarda `/ + = : @` karakterleri elenmiştir; bu değerler
# DATABASE_URL / REDIS_URL içine gömüldüğü için URL'yi bozmasınlar.
#
#
# =============================================================================
# !!!!!!!!!!!!!!!!!!!!!!  EN KRİTİK UYARI  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# =============================================================================
# MASTER_ENCRYPTION_KEY KAYBEDİLİRSE, veritabanındaki şifreli AI sağlayıcı
# anahtarları GERİ ALINAMAZ. Kurtarma yolu YOKTUR:
#   - Veritabanı yedeği işe yaramaz (yedekteki kayıtlar da aynı anahtarla
#     şifrelidir).
#   - Her kiracı kendi OpenAI/Anthropic/Ollama anahtarını PANELDEN yeniden
#     girmek zorunda kalır.
#   - PLATFORM_2FA_ENCRYPTION_KEY ayrıca tanımlanmamışsa panel TOTP gizli
#     anahtarları da bu değerden türetilir; kayıp hâlinde tüm platform
#     yöneticilerinin iki adımlı doğrulaması SIFIRLANMAK zorundadır.
#
# SAKLAMA KURALI: Bu anahtarı veritabanı yedeğinden FİZİKSEL/MANTIKSAL OLARAK
# AYRI bir yerde tutun (kurumsal parola yöneticisi, KMS/HSM, ya da kasada
# mühürlü basılı zarf). Yedek diskiyle aynı yerde durursa tek bir olayda ikisini
# birden kaybedersiniz.
#
# DEĞİŞTİRME KURALI: Anahtarı döndürmek (rotate) ancak eski anahtarla çözüp yeni
# anahtarla yeniden şifreleyen bir göç betiğiyle yapılır. Sadece bu dosyadaki
# değeri değiştirmek, mevcut tüm şifreli kayıtları OKUNAMAZ hâle getirir.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) PostgreSQL — müvekkil verisinin durduğu yer (KVKK: özel nitelikli veri)
# -----------------------------------------------------------------------------
# Kullanıcı adı. "postgres" yerine uygulamaya özel bir ad kullanın.
POSTGRES_USER=nomosos
# Üretim parolası — ÜRET, elle uydurma.  openssl rand -base64 36
# DATABASE_URL içine gömülür; / + = @ : karakterlerinden kaçının.
POSTGRES_PASSWORD=
# Veritabanı adı.
POSTGRES_DB=nomosos


# -----------------------------------------------------------------------------
# 2) Redis — kuyruk / önbellek (oturum ve iş verisi taşır, parolasız BIRAKMAYIN)
# -----------------------------------------------------------------------------
# openssl rand -base64 36
REDIS_PASSWORD=


# -----------------------------------------------------------------------------
# 3) MinIO — belge deposu (S3 uyumlu)
# -----------------------------------------------------------------------------
# Kök kullanıcı = tüm belgelere erişim. Ad tahmin edilebilir olmasın.
MINIO_ROOT_USER=nomosos-prod
# openssl rand -base64 36  (en az 8 karakter zorunlu; 40 kullanın)
MINIO_ROOT_PASSWORD=
# API'nin belgeleri koyacağı kova. İlk açılışta elle oluşturulmalıdır:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod exec minio \
#     mc alias set local http://127.0.0.1:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD"
#   ... exec minio mc mb --ignore-existing local/nomosos-belgeler
#   ... exec minio mc version enable local/nomosos-belgeler   # sürümleme: silme kazası koruması
S3_BUCKET=nomosos-belgeler
# MinIO için anlamsızdır; gerçek AWS S3'e geçilirse gerçek bölge yazılır.
S3_REGION=us-east-1
# MinIO web konsolunu tamamen kapatır (önerilen). Geçici olarak "on" yapıp
# SSH tüneliyle bakabilirsiniz; iş bitince "off"a geri alın.
MINIO_BROWSER=off


# -----------------------------------------------------------------------------
# 4) API sırları
# -----------------------------------------------------------------------------
# EN AZ 32 KARAKTER. Kısa anahtarla uygulama AÇILMAZ (bilinçli kontrol).
#   openssl rand -base64 48
JWT_SECRET=

# 32 BAYT HEX = 64 HANE. Yukarıdaki EN KRİTİK UYARI'yı okumadan doldurmayın.
#   openssl rand -hex 32
MASTER_ENCRYPTION_KEY=

# Platform paneli token'ını imzalayan anahtar. Boş bırakılırsa JWT_SECRET'ten
# tek yönlü türetilir (güvenlidir). Ayrı vermek daha iyidir: EN AZ 32 KARAKTER.
#   openssl rand -base64 48
PLATFORM_JWT_SECRET=

# Panel TOTP gizli anahtarlarını şifreler — 64 hane hex. Boş bırakılırsa
# MASTER_ENCRYPTION_KEY'den türetilir. AYRI VERMEK ÖNERİLİR: spec gereği master
# anahtar panel yolunda kullanılmamalıdır (o anahtar tüm kiracıların LLM
# anahtarlarını da çözer).
#   openssl rand -hex 32
# DEĞİŞTİRİLİRSE mevcut 2FA kayıtları OKUNAMAZ; yöneticiler TOTP'yi yeniden kurar.
PLATFORM_2FA_ENCRYPTION_KEY=

# ÜRETİMDE "true" OLMAK ZORUNDA. NODE_ENV=production iken "true" değilse
# uygulama açılmaz (assertTwoFactorPolicy, apps/api/src/main.ts).
PLATFORM_REQUIRE_2FA=true


# -----------------------------------------------------------------------------
# 5) Ters vekil (reverse proxy)
# -----------------------------------------------------------------------------
# Önünüzde kaç GÜVENİLEN vekil var? Caddy/Traefik/nginx varsa 1 yazın.
# 0 = "X-Forwarded-For başlığına HİÇ bakma". Vekil arkasındayken 0 bırakırsanız
# denetim izindeki tüm IP'ler vekilin IP'si olur; 0 iken doğrudan açarsanız
# istemci başlığı uydurabilir ve 10 yıl saklanan denetim izi sahtelenir.
#
# ZORUNLU ALAN (denetim bulgusu Ö-08): üretimde tanımsız ya da geçersiz bir
# değerle API AÇILMAZ — JWT_SECRET ile aynı desen. Vekiliniz yoksa boş
# bırakmayın, AÇIKÇA 0 yazın: "ayarı unuttum" ile "vekilim yok" ayrılabilsin.
TRUSTED_PROXY_HOPS=1
# TLS vekilde sonlanıyorsa HSTS başlığını API açar.
API_FORCE_HSTS=true


# -----------------------------------------------------------------------------
# 6) Genel adresler (NEXT_PUBLIC_* = BUILD ANINDA gömülür!)
# -----------------------------------------------------------------------------
# DİKKAT: Bu iki değer tarayıcı paketine build sırasında yazılır. Değiştirirseniz
# imajı YENİDEN BUILD etmeniz gerekir; sadece konteyneri yeniden başlatmak
# yetmez. Değer, tarayıcının API'ye ulaşabildiği DIŞ adres olmalıdır
# (http://api:3001 gibi iç adresler tarayıcıdan çözülemez).
NEXT_PUBLIC_API_URL=https://api.ornek-buro.com
NEXT_PUBLIC_ADMIN_API_URL=https://api.ornek-buro.com

# ZORUNLU: Büroya ait web arayüzünün DIŞTAKI kök adresi (CORS için).
# Boş bırakılırsa API CORS'u http://localhost:3000'e kilitler ve üretilmiş
# tarayıcıdan gelen hiçbir istek geçmez (docs/uretim-dagitimi.md §8.2).
WEB_ORIGIN=https://ornek-buro.com

# ZORUNLU: API'nin kimlik sağlayıcıdan görülen genel adresi (SSO/OIDC redirect_uri
# = $API_PUBLIC_URL/api/v1/auth/sso/callback).
API_PUBLIC_URL=https://api.ornek-buro.com

# Prometheus /metrics ucu için Bearer token. Boşsa üretimde uç 404 döner ve
# izleme fiilen kapalı kalır: openssl rand -hex 24
METRICS_TOKEN=

# --- Faz 2: bildirim kanalları ---
# SMTP: parola sıfırlama + süre/duruşma hatırlatma e-postaları + müvekkil e-postası.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NomosOS <bildirim@ornek-buro.com>"
SMTP_SECURE=false
# Demo talepleri bu adrese e-posta olarak düşer.
PLATFORM_NOTIFY_EMAIL=
# Netgsm SMS (sözleşme sonrası) / WhatsApp Cloud API (Meta onayı sonrası) / Expo push.
SMS_PROVIDER_BASE_URL=
SMS_PROVIDER_API_KEY=
SMS_SENDER_TITLE=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=

# --- Faz 3: platform tahsilatı ---
# IYZICO: gerçek tahsilat (sözleşme sonrası). Boş = çevrimiçi ödeme kapalı; havale/EFT + panelden "ödendi işaretle".
ODEME_SAGLAYICI=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
# Platform faturası PDF'inde satıcı bilgisi.
PLATFORM_LEGAL_NAME=
PLATFORM_LEGAL_ADDRESS=
PLATFORM_TAX_NUMBER=
PLATFORM_TAX_OFFICE=


# -----------------------------------------------------------------------------
# 7) AI / BYO-LLM
# -----------------------------------------------------------------------------
# Boş bırakılırsa sağlayıcı tipine göre varsayılan seçilir.
AI_EMBEDDING_MODEL=
# Büro-içi sayılacak EK ana makineler (virgülle). KVKK "veri dışarı çıktı mı"
# kararı sağlayıcı tipine değil ADRESE bakılarak verilir. Yerel LLM'iniz kendi
# alan adınızdaysa buraya yazın; yazmazsanız çağrı "dışsal" sayılır.
# AI_INTERNAL_HOSTS=llm.buro.local,gpu01
AI_INTERNAL_HOSTS=
# Sağlayıcı yanıt vermezse isteğin asılı kalmaması için (ms; 5000-600000).
AI_TIMEOUT_MS=180000
# BYO-LLM maliyeti doğrudan büroya yazıldığı için sınır ürünün parçasıdır.
# İlk ikisi kullanıcı+uç başına, sonraki ikisi BÜRO başına ve uçtan bağımsız
# (denetim bulgusu Ö-10). Kurumsal bir büro tavana takılıyorsa yalnız
# TENANT değerlerini yükseltin; kullanıcı sınırı kaçak döngüye karşı kalsın.
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_DAY=300
AI_RATE_LIMIT_TENANT_PER_MINUTE=60
AI_RATE_LIMIT_TENANT_PER_DAY=2000

# Oran sınırı sayacı NEREDE tutulacak (denetim bulgusu Ö-09).
# BİRDEN FAZLA API ÖRNEĞİ (deploy.replicas > 1) ÇALIŞTIRIYORSANIZ "redis" ZORUNLU:
# süreç-içi sayaç her örnekte ayrı tutulur; 3 örnekte günlük AI tavanı 300'den
# 900'e, portal giriş sınırı 5'ten 15'e çıkar ve hiçbir uyarı çıkmaz.
RATE_LIMIT_BACKEND=redis


# -----------------------------------------------------------------------------
# 8) Yükleme / ayrıştırma sınırları
# -----------------------------------------------------------------------------
MAX_PDF_PAGES=300
API_JSON_BODY_LIMIT=1mb


# -----------------------------------------------------------------------------
# 9) Faturalama
# -----------------------------------------------------------------------------
# KDV oranı koda gömülü DEĞİLDİR; mevzuat değişirse burada değişir.
DEFAULT_VAT_RATE=20
INVOICE_NUMBER_PREFIX=NOM
# "noop" GİB'e hiçbir bağlantı kurmaz ve gönderim isteğinde 503 döner.
EINVOICE_PROVIDER=noop


# -----------------------------------------------------------------------------
# 10) Dağıtım / port bağlama
# -----------------------------------------------------------------------------
# İmaj etiketi — üretimde "latest" yerine sürüm/commit yazın (geri dönüş için).
IMAGE_TAG=latest
# Konteyner portlarının HOST tarafındaki karşılıkları. Hepsi 127.0.0.1'e
# bağlanır; internete açan yalnızca ters vekildir.
API_BIND_PORT=3001
WEB_BIND_PORT=3000
ADMIN_BIND_PORT=3002
PORTAL_BIND_PORT=3003


# -----------------------------------------------------------------------------
# 11) Yedekleme (scripts/prod-backup.sh tarafından okunur)
# -----------------------------------------------------------------------------
# Yedeklerin yazılacağı dizin. Sunucudan BAŞKA bir diske/uzak birime bağlayın.
BACKUP_DIR=/var/backups/nomosos
# Kaç günlük yedek saklansın?
BACKUP_RETENTION_DAYS=30
# Yedekleri GPG ile şifrelemek için alıcı kimliği (boşsa şifrelenmez).
# Yedek dosyaları müvekkil verisi içerir; şifresiz saklamak KVKK riskidir.
# BACKUP_GPG_RECIPIENT=yedek@ornek-buro.com
BACKUP_GPG_RECIPIENT=
