{
  "name": "@nomosos/uyap-extension",
  "version": "0.1.0",
  "private": true,
  "description": "NomosOS UYAP Köprüsü — UYAP Avukat Portalı ile NomosOS arasında yarı otomatik dosya/evrak köprüsü (Chrome MV3)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "package": "node build.mjs && node scripts/package-zip.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
