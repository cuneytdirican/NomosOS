{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    // apps/mobile (Expo/React Native) BİLEREK `build` script'i TAŞIMAZ.
    //
    // Turbo, bir pakette görev adında script yoksa o paketi görevden sessizce
    // eler; yani "hariç tutma" listesi yerine script'in yokluğu kullanılır.
    // Gerekçe: Expo uygulaması `next build` / `tsc` gibi tek komutla bir
    // çıktı klasörü üretmez. Karşılığı olan şey `eas build`tır ve o, ağ
    // erişimi + kimlik doğrulaması + imzalama anahtarları ister; CI'da her
    // `pnpm build` çağrısında çalışması ne mümkün ne de istenir. Sahte bir
    // `build: "echo ok"` script'i eklemek daha kötü olurdu: yeşil bir görev,
    // aslında hiçbir şeyin doğrulanmadığını gizlerdi.
    //
    // Mobil paketin derleme güvencesi `typecheck` (tsc --noEmit) ile alınır;
    // o görev VARDIR ve `pnpm typecheck` ile monorepo genelinde koşar.
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    // LINT GÖREVİ BİLEREK YOKTUR (denetim bulgusu Ö-33b).
    //
    // Eskiden burada `"lint": {}` duruyordu ve kökteki `pnpm lint`
    // (`turbo run lint`) onu çağırıyordu. Hiçbir pakette `lint` script'i
    // olmadığı için Turbo bütün paketleri sessizce eliyor, komut 0 görevle
    // BAŞARIYLA çıkıyordu: yeşil yanan ama hiçbir şeyi denetlemeyen bir
    // kontrol. Çalışmayan bir kontrolden daha kötüsü, çalıştığı sanılandır.
    //
    // Lint artık kökte TEK bir düz yapılandırmayla koşar (`eslint.config.mjs`)
    // ve `pnpm lint` doğrudan `eslint .` çağırır. Turbo'ya taşımanın tek
    // kazancı önbellek olurdu; buna karşılık 14 ayrı paket script'i ve 14
    // ayrı kural setinin zamanla ayrışma riski gelirdi. Kurallar depo
    // genelinde AYNI olmalıdır.
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
