// NomosOS çekirdek veri modeli
// docs/02-veri-modeli.md ile birebir uyumludur; değişiklikler iki yerde birden yapılmalıdır.
// Tüm iş verileri tenantId ile çok-kiracılı (multi-tenant) ayrıştırılır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Kiracı ve kullanıcı ----------

/// Büronun AI veri politikası (docs/04-kvkk-veri-guvenligi.md).
/// SADECE_YEREL seçildiğinde dış sağlayıcıya (adres tabanlı tespit) hiçbir
/// istek yapılamaz; yanlışlıkla eklenmiş bir bulut sağlayıcısı sessiz yedek
/// rota olamaz.
enum AiPolicy {
  SERBEST
  SADECE_YEREL
}

model Tenant {
  id              String   @id @default(uuid())
  name            String // Büro adı
  /// BÜRONUN VERGİ KİMLİK BİLGİLERİ (F2-Ö-16): e-Fatura/e-Arşiv/e-SMM'de
  /// SATICI VKN'si GİB'e gönderilmek ZORUNDADIR; alan yoksa belge reddedilir.
  /// null = henüz girilmemiş; e-belge gönderimi bunu 400 ile reddeder.
  taxNumber       String?
  taxOffice       String?
  address         String?
  /// SERBEST | SADECE_YEREL — dış AI sağlayıcısı kullanımına izin var mı?
  aiPolicy        AiPolicy @default(SERBEST)
  /// Otomatik belge hattının dış sağlayıcıya MASKELİ metin göndermesine
  /// verilen tek seferlik açık rıza. false ise hattın AI adımları ATLANIR
  /// ve belge triyaja düşer (docs/04, kabul kriteri 1).
  autoMaskConsent Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users             User[]
  clients           Client[]
  cases             Case[]
  deadlineRules     DeadlineRule[]
  caseNotes         CaseNote[]
  caseDecisions     CaseDecision[]
  aiProviderConfigs AiProviderConfig[]
  aiTaskRoutes      AiTaskRoute[]
  auditLogs         AuditLog[]
}

enum UserRole {
  ADMIN
  PARTNER
  AVUKAT
  STAJYER
  SEKRETER
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole
  barNumber    String? // Baro sicil no
  isActive     Boolean  @default(true)

  /// ── HESAP KİLİDİ (KALICI) — denetim bulgusu K-03 ─────────────────────────
  /// Üç kimlik alanının EN GENİŞ YETKİLİSİ, en korumasızıydı: `PlatformUser`
  /// `tokenVersion/failedAttempts/lockedUntil` taşıyor, `PortalUser`
  /// `failedAttempts/failureWindowEndsAt/lockedUntil/sessionsValidFrom`
  /// taşıyordu; büronun TÜM verisine bakan avukat hesabında hiçbiri yoktu.
  /// Tek koruma `LoginThrottleGuard`'ın SÜREÇ İÇİ `IP|e-posta` kovasıydı: 100
  /// farklı çıkış IP'sinden dakikada 500 deneme yapılabiliyor, hesap hiç
  /// kilitlenmiyor, süreç yeniden başlayınca sayaç sıfırlanıyordu.
  failedAttempts      Int       @default(0)
  /// Sayaç penceresinin bittiği an — bu andan sonra birikmemiş hatalar unutulur.
  failureWindowEndsAt DateTime?
  /// Kilidin bittiği an. null / geçmiş = kilit yok.
  lockedUntil         DateTime?

  /// ── OTURUM İPTALİ — denetim bulgusu K-03 / Ö-34 ──────────────────────────
  /// Bu andan ÖNCE üretilmiş kiracı token'ları geçersizdir. Çıkış (logout),
  /// parola değişimi, yönetici tarafından parola sıfırlama ve hesabın
  /// pasifleştirilmesi bu damgayı tazeler. Sızmış bir parolayla açılmış oturum
  /// artık ürün üzerinden kapatılabilir; eskiden tek çözüm `psql` ile elle
  /// `passwordHash` yazmaktı ve o bile açık token'ı düşürmüyordu.
  sessionsValidFrom DateTime?

  /// ── BÜRO İÇİ MESAJLAŞMA ──────────────────────────────────────────────────
  /// Profil fotoğrafı — MinIO nesne anahtarı (avatarlar/ öneki).
  avatarStorageKey String?
  /// Son kalp atışı anı — 60 sn içinde vuruş varsa "çevrimiçi" görünür.
  lastSeenAt       DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  responsibleCases Case[]          @relation("ResponsibleUser")
  assignedTasks    Task[]          @relation("Assignee")
  reviewTasks      Task[]          @relation("Reviewer")
  deadlines        Deadline[]      @relation("DeadlineOwner")
  /// denetim bulgusu K-14 — kural motorundan üretilmiş sürenin girdisini
  /// düzelten avukat/ortak.
  correctedDeadlines Deadline[]   @relation("DeadlineCorrectedBy")
  timelineEvents   TimelineEvent[]
  caseNotes        CaseNote[]
  taskStatusLogs   TaskStatusLog[]
  aiUsageLogs      AiUsageLog[]
  timeEntries      TimeEntry[]

  /// Büro içi mesajlaşma (Office* modelleri — AI sohbeti ChatMessage'dır)
  officeSentMessages     OfficeMessage[] @relation("OfficeSent")
  officeReceivedMessages OfficeMessage[] @relation("OfficeReceived")
  officeReadStates       OfficeReadState[]
  officeCallsMade        OfficeCall[]    @relation("OfficeCaller")
  officeCallsReceived    OfficeCall[]    @relation("OfficeCallee")

  @@index([tenantId])
}

// ---------- Müvekkil (CRM çekirdeği) ----------

enum ClientType {
  GERCEK_KISI
  TUZEL_KISI
}

model Client {
  id            String     @id @default(uuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  type          ClientType
  name          String // Ad soyad veya ticaret unvanı
  tckn          String? // Gerçek kişi — KVKK: uygulama katmanında maskeli gösterim
  taxNumber     String? // Tüzel kişi vergi no
  taxOffice     String?
  email         String?
  phone         String?
  address       String?
  iban          String?
  notes         String?
  /// Segment etiketi: "Kurumsal" | "Bireysel" | serbest metin
  category      String?
  /// Büro içi müvekkil referans kodu (örn. "MV-2026-001")
  referenceCode String?
  /// BÜROYA ÖZEL ALANLAR (rakip analizi — Avukat Bulut deseni):
  /// [{"key":"cocukSayisi","label":"Çocuk sayısı","value":"2"}] — JSON.
  /// Anahtarlar koddan DEĞİL avukatın girişinden gelir; UI koşullu gösterim için
  /// etiketle listeler. Kişisel veri işlendiği için KVKK politika matrisi K1 geçerli.
  customFieldsJson String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  contacts         ClientContact[]
  cases            Case[]
  powerOfAttorneys PowerOfAttorney[]
  financialEntries FinancialEntry[]
  feeAgreements    FeeAgreement[]
  randevular       Randevu[]
  timeEntries      TimeEntry[]
  invoices         Invoice[]
  payments         Payment[]

  /// Faz 5 — müvekkil portalı, iletişim merkezi, sözleşmeler
  portalUsers        PortalUser[]
  portalInvites      PortalInvite[]
  portalPublications PortalPublication[]
  communicationLogs  CommunicationLog[]
  outboundMessages   OutboundMessage[]
  inboundMessages    InboundMessage[]
  contracts          Contract[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, category])
  @@index([tenantId, referenceCode])
}

/// Tüzel kişi yetkilileri / ilgili kişiler
model ClientContact {
  id       String  @id @default(uuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fullName String
  title    String? // Görevi (örn. Genel Müdür)
  email    String?
  phone    String?
  notes    String?

  @@index([clientId])
}

// ---------- Dosya (sistemin merkezi) ----------

enum CaseType {
  DAVA
  ICRA
  ARABULUCULUK
  CEZA
  DANISMANLIK
}

enum CaseStatus {
  ACIK
  DERDEST
  KARAR
  ISTINAF
  TEMYIZ
  KESINLESTI
  ICRADA
  KAPANDI
  ARSIV
}

model Case {
  id                String     @id @default(uuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  clientId          String
  client            Client     @relation(fields: [clientId], references: [id])
  responsibleUserId String?
  responsibleUser   User?      @relation("ResponsibleUser", fields: [responsibleUserId], references: [id])
  type              CaseType
  status            CaseStatus @default(ACIK)
  title             String
  courtName         String? // Örn. "İstanbul 12. İş Mahkemesi" / "Ankara 4. İcra Dairesi"
  fileNumber        String? // Esas no, örn. 2026/145
  judgeName         String?
  subject           String? // Dava konusu / takip konusu
  amount            Decimal?   @db.Decimal(18, 2) // Dava değeri / takip tutarı (TRY)
  openedAt          DateTime   @default(now())
  closedAt          DateTime?
  /// Denormalize: en yakın gelecek duruşma tarihi — duruşma yazımlarında güncellenir
  nextHearingAt     DateTime?
  /// Dosyadaki son hareket zamanı (safahat/not/karar/duruşma yazımı)
  lastActivityAt    DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  parties          CaseParty[]
  hearings         Hearing[]
  deadlines        Deadline[]
  tasks            Task[]
  documents        Document[]
  timelineEvents   TimelineEvent[]
  notes            CaseNote[]
  decisions        CaseDecision[]
  powerOfAttorneys PowerOfAttorney[]
  financialEntries FinancialEntry[]

  documentChunks  DocumentChunk[]
  actionProposals DocumentActionProposal[]
  chatSessions    ChatSession[]
  smartNotes      SmartNote[]
  analysisReports CaseAnalysisReport[]
  petitions       Petition[]
  caseLawRefs     CaseLawReference[]

  /// Faz 3 — icra takibi (bir Case en fazla bir icra dosyasına karşılık gelir)
  enforcementFile EnforcementFile?
  feeAgreements   FeeAgreement[]
  timeEntries     TimeEntry[]

  /// Faz 4 — strateji, simülasyon, risk, delil, bilirkişi
  strategies     Strategy[]
  simulationRuns SimulationRun[]
  riskScores     RiskScore[]
  claims         Claim[]
  evidences      Evidence[]
  expertReports  ExpertReport[]

  /// Faz 5 — iletişim merkezi, vekalet kapsam analizi, sözleşmeler
  communicationLogs CommunicationLog[]
  outboundMessages  OutboundMessage[]
  inboundMessages   InboundMessage[]
  poaScopeChecks    PoaScopeCheck[]
  contracts         Contract[]

  /// UYAP Köprüsü — UYAP dosya numarası ↔ NomosOS dosyası bağlantısı
  uyapLinks UyapCaseLink[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, nextHearingAt])
  @@index([tenantId, lastActivityAt])
  @@index([clientId])
}

enum PartyRole {
  DAVACI
  DAVALI
  MUDAHIL
  ALACAKLI
  BORCLU
  SANIK
  MUSTEKI
  KATILAN
  TANIK
  DIGER
}

model CaseParty {
  id         String    @id @default(uuid())
  caseId     String
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  role       PartyRole
  name       String
  isClient   Boolean   @default(false) // Bu taraf bizim müvekkilimiz mi
  lawyerName String? // Karşı taraf vekili
  notes      String?

  @@index([caseId])
}

// ---------- Duruşma ----------

enum HearingType {
  DURUSMA
  ON_INCELEME
  KESIF
  E_DURUSMA
  MUZAKERE
  DIGER
}

enum HearingStatus {
  PLANLANDI
  YAPILDI
  ERTELENDI
  IPTAL
}

model Hearing {
  id          String        @id @default(uuid())
  tenantId    String
  caseId      String
  case        Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type        HearingType   @default(DURUSMA)
  status      HearingStatus @default(PLANLANDI)
  date        DateTime
  courtroom   String?
  note        String? // Ara karar / sonuç özeti
  /// Duruşma hazırlığının tamamlandığı an
  preparedAt  DateTime?
  /// Duruşma hazırlık notu / brifing özeti
  prepSummary String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId, date])
  @@index([tenantId, status, date])
  @@index([caseId])
}

// ---------- Süre / Deadline ----------

enum DeadlineSource {
  MANUEL
  KURAL // Deterministik kural motoru hesabı
  AI_ONERISI // AI tespiti — avukat onayı olmadan kesinleşmez
}

enum DeadlineStatus {
  BEKLIYOR // AI önerisi: onay bekliyor
  ONAYLANDI
  TAMAMLANDI
  KACIRILDI
  IPTAL
}

model Deadline {
  id            String         @id @default(uuid())
  tenantId      String
  caseId        String
  case          Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  ownerId       String?
  owner         User?          @relation("DeadlineOwner", fields: [ownerId], references: [id])
  title         String // Örn. "İstinaf süresi son günü"
  /// Gün hassasiyetli değer; motor UTC gün başı üretir. @db.Date, negatif ofsetli
  /// saat dilimlerinde gün kaymasını önler (Holiday.date ile aynı sözleşme).
  dueDate       DateTime       @db.Date
  source        DeadlineSource @default(MANUEL)
  status        DeadlineStatus @default(ONAYLANDI)
  legalBasis    String? // Dayanak: örn. "HMK m.345 — 2 hafta"
  computeNote   String? // Hesap izi: tebliğ tarihi, yöntem, tatil kaydırması
  /// Hesabın dayandığı DeadlineRule.key (örn. "HMK_CEVAP")
  ruleKey       String?
  /// Süreyi başlatan olay tarihi (tebliğ/karar/olay)
  triggerDate   DateTime?
  /// Tebligat yöntemi — bazı sürelerde başlangıç gününü etkiler
  serviceMethod ServiceMethod?

  // ---- denetim bulgusu K-14: girdi düzeltmesinin izi (Modül 04 KK8) ----
  // Kural motorundan üretilen sürenin son günü doğrudan değiştirilemez; girdi
  // düzeltilir ve motor YENİDEN KOŞAR. İLK TESPİT aşağıdaki alanlarda
  // dondurulur ki "ne sanıyorduk / ne çıktı" farkı kayıttan okunabilsin.
  // Bu üç alan İLK düzeltmede bir kez yazılır, sonraki düzeltmelerde DEĞİŞMEZ.
  /// İlk tespit edilen tetikleyici (tebliğ/karar) tarihi.
  originalTriggerDate   DateTime?
  /// İlk tespit edilen tebligat yöntemi.
  originalServiceMethod ServiceMethod?
  /// İlk hesapta motorun ürettiği son gün.
  originalDueDate       DateTime?      @db.Date
  /// Girdiyi son düzelten kullanıcı (AVUKAT/ORTAK/YÖNETİCİ).
  correctedById         String?
  correctedBy           User?          @relation("DeadlineCorrectedBy", fields: [correctedById], references: [id])
  correctedAt           DateTime?
  /// Kaç kez düzeltildi — sıfırdan büyükse kayıt "düzeltilmiş" sayılır.
  correctionCount       Int            @default(0)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId, dueDate])
  @@index([tenantId, status, dueDate])
  @@index([caseId])
  @@index([ruleKey])
  @@index([correctedById])
}

// ---------- Süre motoru: kurallar ve tatiller ----------

enum DurationUnit {
  GUN
  HAFTA
  AY
  YIL
}

/// Tebligat yöntemi — süre başlangıcını etkileyebilir
enum ServiceMethod {
  ELDEN
  POSTA
  ETEBLIGAT
  DURUSMADA
  DIGER
}

/// Adli tatil uzaması rejimi — yargı koluna göre gün sayısı ve çapa değişir.
enum RecessExtensionRule {
  HMK_104 // Adli tatilin bittiği günden itibaren 1 hafta
  IYUK_8 // Ara vermenin sona erdiği günü izleyen tarihten itibaren 7 gün
  CMK_331 // Tatilin bittiği günden itibaren 3 gün
}

/// Sürenin tabi olduğu usul kanunu — hesap izindeki madde referansları için.
enum ProcedureCode {
  HMK
  IIK
  CMK
  IYUK
}

/// Kanuni süre kuralı. tenantId null ise sistem kuralıdır (tüm bürolar görür).
model DeadlineRule {
  id                    String              @id @default(uuid())
  tenantId              String?
  tenant                Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key                   String // Örn. "HMK_CEVAP"
  name                  String // Örn. "Cevap dilekçesi süresi"
  description           String?
  durationValue         Int
  durationUnit          DurationUnit
  legalBasis            String // Örn. "HMK m.127 — 2 hafta"
  caseTypes             String[] // CaseType değerleri; boş ise tüm dosya tipleri
  /// Bu kuralın süresi adli tatilde uzar mı (HMK m.104). İcra takip süreleri ve
  /// HMK m.103 istisnaları için false. REJİM KARARI KURALDAN GELİR, istemciden DEĞİL.
  judicialRecessApplies Boolean             @default(true)
  /// Adli tatil uzaması rejimi: HMK_104 (+7) | IYUK_8 (+1+7) | CMK_331 (+3)
  recessRule            RecessExtensionRule @default(HMK_104)
  /// Hesap izindeki madde referanslarının seçileceği usul kanunu
  procedureCode         ProcedureCode       @default(HMK)
  isActive              Boolean             @default(true)
  isSystem              Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([key])
  @@index([isActive])
}

enum HolidayType {
  RESMI_TATIL
  ADLI_TATIL
}

/// Resmi tatil ve adli tatil günleri — süre motoru bunları çalışmayan gün sayar.
model Holiday {
  id            String      @id @default(uuid())
  date          DateTime    @db.Date
  name          String
  type          HolidayType
  year          Int
  /// Arife günü (2429 s.K. m.2/A) — saat 13.00'e kadar mesai vardır.
  /// TAM TATİL DEĞİLDİR: HMK m.93 kaydırmasını TETİKLEMEZ.
  isHalfDay     Boolean     @default(false)
  /// Hicri takvime bağlı, resmî ilanla kesinleşecek tarih (Ramazan/Kurban).
  isApproximate Boolean     @default(false)
  createdAt     DateTime    @default(now())

  /// Aynı güne birden fazla resmî tatil düşebilir (ör. bayram + 19 Mayıs);
  /// tekillik ad ile birlikte kurulur.
  @@unique([date, type, name])
  @@index([year])
  @@index([type, date])
}

// ---------- Görev / Workflow ----------

enum TaskStatus {
  ACIK
  DEVAM_EDIYOR
  KONTROLDE
  ONAY_BEKLIYOR
  TAMAMLANDI
  IPTAL
}

enum TaskPriority {
  DUSUK
  NORMAL
  YUKSEK
  KRITIK
}

model Task {
  id          String       @id @default(uuid())
  tenantId    String
  caseId      String?
  case        Case?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  title       String
  description String?
  assigneeId  String
  assignee    User         @relation("Assignee", fields: [assigneeId], references: [id])
  reviewerId  String?
  reviewer    User?        @relation("Reviewer", fields: [reviewerId], references: [id])
  status      TaskStatus   @default(ACIK)
  priority    TaskPriority @default(NORMAL)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  statusLogs TaskStatusLog[]

  @@index([tenantId, status])
  @@index([assigneeId, status])
  @@index([tenantId, dueDate])
  @@index([caseId])
}

/// Görev durum geçiş günlüğü — workflow denetim izi
model TaskStatusLog {
  id         String      @id @default(uuid())
  taskId     String
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus TaskStatus?
  toStatus   TaskStatus
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  note       String?
  createdAt  DateTime    @default(now())

  @@index([taskId, createdAt])
  @@index([userId])
}

// ---------- Belge ----------

enum DocumentClass {
  DILEKCE
  TENSIP_ZAPTI
  ARA_KARAR
  GEREKCELI_KARAR
  BILIRKISI_RAPORU
  DURUSMA_TUTANAGI
  TEBLIGAT
  MUZEKKERE
  VEKALETNAME
  SOZLESME
  DELIL
  FATURA
  ICRA_EVRAKI
  /// İİK m.89/2 üçüncü kişi (banka vb.) haciz cevabı (rakip analizi — B7).
  BANKA_HACIZ_CEVABI
  DIGER
}

/// Belge işleme hattı adım durumu (OCR / parçalama / gömme).
enum ProcessingStatus {
  BEKLIYOR
  TAMAM
  BASARISIZ
  GEREKSIZ // Adım bu belge için uygulanamaz (örn. metin katmanı zaten var / görselsiz)
}

model Document {
  id          String            @id @default(uuid())
  tenantId    String
  caseId      String?
  case        Case?             @relation(fields: [caseId], references: [id], onDelete: SetNull)
  name        String
  class       DocumentClass     @default(DIGER)
  classSource String? // MANUEL | AI (AI sınıflandırdıysa güven skoru ile)
  mimeType    String?
  sizeBytes   Int?
  storageKey  String // MinIO/S3 nesne anahtarı
  uploadedBy  String? // User id
  aiSummary   String? // AI tarafından üretilen kısa özet
  /// İ-16: YUMUŞAK SİLME. Fiziksel delete yerine bu alan yazılır; tüm listeler
  /// `deletedAt: null` süzmesiyle çalışır. S3 nesnesi saklanır — hukuki geri
  /// dönüşüm ve denetim izi için.
  deletedAt   DateTime?
  /// Metin çıkarma sonucu — HAM metin (maskesiz). LLM'e giderken scanPii'den geçirilir.
  ocrText     String?
  ocrStatus   ProcessingStatus?
  chunkStatus ProcessingStatus?
  /// İçerik SHA-256 (hex) — aynı kiracıda yinelenen yüklemeyi engellemek için.
  hash        String?
  /// MANUEL | UYAP | SISTEM
  source      String?
  pageCount   Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  chunks    DocumentChunk[]
  pipelines PipelineRun[]
  proposals DocumentActionProposal[]
  /// Büro içi mesajlaşma ekleri
  officeAttachments OfficeMessage[] @relation("OfficeAttachment")

  @@index([tenantId])
  @@index([caseId])
  @@index([tenantId, hash])
  @@index([tenantId, ocrStatus])
}

/// Belgenin RAG için bölünmüş parçası. İÇERİK MASKELİ SAKLANIR (KVKK):
/// content alanına yazmadan önce packages/ai scanPii/maskText uygulanır.
/// pgvector Faz 3'e bırakıldı — embedding Float[] olarak tutulur, benzerlik JS'te kosinüs ile.
model DocumentChunk {
  id             String   @id @default(uuid())
  tenantId       String
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  caseId         String?
  case           Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  index          Int // Belge içindeki sıra (0'dan başlar)
  content        String // MASKELİ metin
  tokenCount     Int?
  embedding      Float[] // Boş dizi = gömme üretilmedi (anahtar kelime yedeği kullanılır)
  embeddingModel String?
  sourceLabel    String // Atıf etiketi, örn. "Bilirkişi Raporu · s.3"
  createdAt      DateTime @default(now())

  @@index([tenantId, documentId])
  @@index([caseId])
}

enum PipelineStatus {
  BEKLIYOR
  CALISIYOR
  TAMAM
  BASARISIZ
  KISMI // Bazı adımlar başarılı, bazıları başarısız
}

/// Belge otomatik aksiyon hattının bir çalıştırması (Faz 2'de senkron).
model PipelineRun {
  id           String         @id @default(uuid())
  tenantId     String
  documentId   String
  document     Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status       PipelineStatus @default(BEKLIYOR)
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?
  errorMessage String?
  /// Adım adım sonuç (JSON dizi): [{ step, status, durationMs, error? }]
  stepsJson    String?

  @@index([tenantId, startedAt])
  @@index([documentId])
  @@index([tenantId, status])
}

enum ProposalType {
  GOREV
  SURE
  SAFAHAT
  MUVEKKIL_BILGILENDIRME
  DOSYA_ESLESTIRME
  DURUSMA_GUNCELLEME
}

enum ProposalStatus {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
  UYGULANDI
}

/// AI'nın belgeden çıkardığı AKSİYON ÖNERİSİ. Avukat onaylamadan hiçbir kayıt oluşmaz.
/// Süre önerilerinde tarih AI'dan DEĞİL, onay anında deterministik motordan hesaplanır.
model DocumentActionProposal {
  id          String         @id @default(uuid())
  tenantId    String
  documentId  String
  document    Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  caseId      String?
  case        Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  type        ProposalType
  status      ProposalStatus @default(BEKLIYOR)
  title       String
  /// Öneriye özgü veri (JSON): görev/süre/safahat alanları
  payloadJson String
  confidence  Float?
  reasoning   String?
  /// Belgeden birebir alıntı — kaynak gösterme zorunluluğu (uydurma iddia elemesi)
  sourceQuote String?
  decidedBy   String? // User id
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())

  @@index([tenantId, status])
  @@index([documentId])
  @@index([caseId])
}

// ---------- AI dosya asistanı (sohbet) ----------

model ChatSession {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String // User id
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([tenantId, userId, updatedAt])
  @@index([caseId])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id            String      @id @default(uuid())
  sessionId     String
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role          ChatRole
  content       String
  /// Atıf listesi (JSON dizi): [{ label, documentId?, chunkId?, quote? }]
  citationsJson String?
  model         String?
  aiUsageLogId  String?
  createdAt     DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// ---------- Akıllı notlar ve dosya analizi ----------

enum NoteKind {
  GENEL
  DURUSMA_HAZIRLIK
  STRATEJI
  HATIRLATMA
}

/// Not kaynağı — AI üretimi notlar avukat onayına kadar öneri niteliğindedir.
enum NoteSource {
  MANUEL
  AI
}

model SmartNote {
  id         String     @id @default(uuid())
  tenantId   String
  caseId     String
  case       Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId     String? // User id — AI üretimlerinde null olabilir
  content    String
  kind       NoteKind   @default(GENEL)
  source     NoteSource @default(MANUEL)
  /// AI üretimi notlar için avukat onayı; MANUEL notlarda oluştururken true yazılır.
  isApproved Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([tenantId, caseId])
  @@index([caseId, kind])
  @@index([tenantId, isApproved])
}

/// Dosya analiz raporu — DEĞİŞTİRİLEMEZ. Yeni analiz = yeni kayıt (versiyon güncellenmez).
model CaseAnalysisReport {
  id          String   @id @default(uuid())
  tenantId    String
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Rapor gövdesi (JSON): özet, riskler, güçlü/zayıf yönler, atıflar
  contentJson String
  model       String?
  createdBy   String // User id
  createdAt   DateTime @default(now())

  @@index([tenantId, caseId, createdAt])
}

// ---------- Safahat / zaman çizelgesi ----------

model TimelineEvent {
  id        String   @id @default(uuid())
  tenantId  String
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  date      DateTime @default(now())
  title     String // Örn. "Bilirkişi raporu tebliğ edildi"
  detail    String?
  source    String? // MANUEL | UYAP | SISTEM | AI
  createdAt DateTime @default(now())

  @@index([caseId, date])
}

// ===========================================================================
// BÜRO İÇİ MESAJLAŞMA (WhatsApp tarzı) — Office* öneki AI sohbetinin
// ChatMessage modeliyle KARIŞMAZ.
//
// ÜRÜN İLKESİ — MESAJ SİLME YOK: OfficeMessage'da deletedAt alanı YOKTUR ve
// bu varlık için delete ucu YAYINLANMAZ. Büro içi yazışma denetim izidir.
// ===========================================================================

/// Büro içi 1:1 mesaj. Sohbetler (senderId, recipientId) çiftiyle gruplanır.
model OfficeMessage {
  id          String    @id @default(uuid())
  tenantId    String
  senderId    String
  sender      User      @relation("OfficeSent", fields: [senderId], references: [id])
  recipientId String
  recipient   User      @relation("OfficeReceived", fields: [recipientId], references: [id])
  /// Metin içeriği; yalnız-ekli mesajda null.
  content     String?
  /// Ek dosyası — Document olarak saklanır (disk kotasına işler).
  attachmentId String?
  attachment  Document? @relation("OfficeAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, senderId, recipientId, createdAt])
  @@index([tenantId, recipientId, createdAt])
}

/// Kullanıcının bir kişiyle olan sohbeti son okuduğu mesaj.
model OfficeReadState {
  id                String   @id @default(uuid())
  tenantId          String
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  peerId            String
  /// Son okunan mesaj kimliği — bu id'ye kadarki mesajlar "okundu" sayılır.
  lastReadMessageId String?
  lastReadAt        DateTime @default(now())

  @@unique([tenantId, userId, peerId])
  @@index([tenantId, userId])
}

/// Video arama kaydı — WebRTC sinyalleşmesi polling ile taşınır.
model OfficeCall {
  id         String    @id @default(uuid())
  tenantId   String
  callerId   String
  caller     User      @relation("OfficeCaller", fields: [callerId], references: [id])
  calleeId   String
  callee     User      @relation("OfficeCallee", fields: [calleeId], references: [id])
  /// RINGING | ACTIVE | ENDED | REJECTED | MISSED
  status     String    @default("RINGING")
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime  @default(now())

  signals    OfficeCallSignal[]

  @@index([tenantId, calleeId, createdAt])
  @@index([tenantId, callerId, createdAt])
}

/// WebRTC sinyal kuyruğu — offer / answer / ICE candidate.
model OfficeCallSignal {
  id          String     @id @default(uuid())
  callId      String
  call        OfficeCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  /// Gönderen kullanıcı (karşı taraf alır).
  fromUserId  String
  /// OFFER | ANSWER | CANDIDATE
  kind        String
  /// SDP / aday JSON'u.
  payloadJson String
  createdAt   DateTime   @default(now())

  @@index([callId, createdAt])
}

// ===========================================================================
// DİSK KOTASI — lisans planına dahil kota + satın alınan ek kota.
// Kredi cüzdanını izler: satın alınan kota devreder. Kullanım sayacı Document
// eklendiğinde artar; yumuşak silinen belge depoda yer tuttuğu için düşmez.
// ===========================================================================

/// Büronun disk kotası — tenant başına tek kayıt.
model DiskQuota {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  /// Abonelik planının dahil kotası (bayt) — planın diskQuotaGb alanından.
  includedBytes  BigInt   @default(0)
  /// Satın alınan ek kota (bayt) — devreder, süresi dolmaz.
  purchasedBytes BigInt   @default(0)
  /// Kullanılan bayt — Document kayıtlarının sizeBytes toplamı.
  usedBytes      BigInt   @default(0)
  /// Sayacın son yeniden hesaplanma anı (düzeltme koşusu).
  recomputedAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

/// Kota değişikliği kaydı — satın alma ve düzeltmeler denetim iziyle işler.
/// Uygulama DÖRT-GÖZ onayına tabidir (PlatformApprovalRequest üzerinden).
model DiskQuotaAdjustment {
  id             String   @id @default(uuid())
  tenantId       String
  /// +bayt (satın alma) / -bayt (düzeltme).
  deltaBytes     BigInt
  reason         String
  /// Açan platform kullanıcısı.
  createdBy      String
  approvalStatus String   @default("BEKLIYOR") // BEKLIYOR | ONAYLANDI | REDDEDILDI
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ===========================================================================
// UYAP KÖPRÜSÜ (docs/05-uyap-entegrasyonu.md) — eklentinin arka ucu.
// ===========================================================================

/// Web arayüzünde avukatın ürettiği kısa ömürlü eşleştirme kodu.
model UyapPairing {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  /// "AB12-CD34" biçiminde 8 haneli kod.
  code      String    @unique
  expiresAt DateTime
  /// Kod kullanıldığında eklenti token'ının id'si yazılır.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, createdAt])
}

/// Eşleştirilmiş tarayıcı eklentisi — iptal edilebilir extension token.
/// Erişim jetonu 12 saat; yenileme jetonu rotasyonlu.
model UyapExtensionToken {
  id               String    @id @default(uuid())
  tenantId         String
  userId           String
  deviceName       String
  extensionVersion String
  /// SHA-256 (hex) — ham token asla saklanmaz.
  accessTokenHash  String    @unique
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([tenantId, userId])
}

/// UYAP dosya numarası ↔ NomosOS dosyası bağlantısı.
model UyapCaseLink {
  id          String   @id @default(uuid())
  tenantId    String
  uyapDosyaNo String
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Eşleştirmeyi yapan kullanıcı (otomatik eşleşmede null).
  matchedBy   String?
  createdAt   DateTime @default(now())

  @@unique([tenantId, uyapDosyaNo])
}

/// Eşleşmeyen UYAP dosyaları — avukatın eşleştirme kuyruğu.
model UyapMatchQueue {
  id             String    @id @default(uuid())
  tenantId       String
  uyapDosyaNo   String
  /// SyncFileDto — eklentiden gelen ham özet.
  payloadJson    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?
  resolvedCaseId String?

  @@unique([tenantId, uyapDosyaNo])
}

/// UYAP'tan gelen safahat/duruşma kaydı — externalHash ile idempotent.
model UyapEventRecord {
  id           String   @id @default(uuid())
  tenantId     String
  caseId       String?
  uyapDosyaNo  String
  /// SAFAHAT | DURUSMA
  kind         String
  externalHash String
  tarih        DateTime
  islem        String
  aciklama     String?
  birim        String?
  sira        Int?
  salon        String?
  createdAt    DateTime @default(now())

  @@unique([tenantId, externalHash])
  @@index([tenantId, caseId])
  @@index([tenantId, createdAt])
}

// ---------- Dosya notları ----------

/// Dosyaya iliştirilen serbest not. Sabitlenen notlar dosya başında görünür.
model CaseNote {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([caseId, createdAt])
  @@index([caseId, isPinned])
}

// ---------- Kararlar ----------

enum DecisionType {
  ARA_KARAR
  GEREKCELI_KARAR
  ISTINAF_KARARI
  TEMYIZ_KARARI
  KESIN_KARAR
}

/// Dosyada verilen kararlar — süre motorunun tetikleyicisi olabilir.
model CaseDecision {
  id         String       @id @default(uuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  caseId     String
  case       Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type       DecisionType
  date       DateTime
  summary    String
  outcome    String? // Örn. "Kabul" / "Kısmen kabul" / "Red"
  documentId String? // İlgili belge (Document.id)
  createdAt  DateTime     @default(now())

  @@index([tenantId, date])
  @@index([caseId, date])
}

// ---------- Vekaletname ----------

/// Vekaletname tipi (docs/moduller/12-vekaletname.md). Tip, kapsam yeterlilik
/// analizinin ilk ayrımıdır: boşanma/ceza/icra dosyaları özel yetki ister.
enum PoaType {
  GENEL
  OZEL
  BOSANMA
  CEZA
  ICRA
  SIRKET
  DIGER
}

model PowerOfAttorney {
  id         String    @id @default(uuid())
  tenantId   String
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  caseId     String?
  case       Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  notary     String? // Noter adı
  number     String? // Yevmiye no
  issuedAt   DateTime
  expiresAt  DateTime?
  revokedAt  DateTime? // Azil tarihi
  scope      String? // Kapsam metni
  documentId String? // Taranmış vekaletname belgesi
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // ---- Faz 5 (Modül 12) ----
  /// Vekaletname tipi. null = eski kayıt, henüz sınıflandırılmadı.
  type           PoaType?
  /// Özel yetki maddeleri (JSON dizi): [{ code, label, present }] — kod kataloğu
  /// spec'teki AHZU_KABZ | SULH | IBRA | FERAGAT | KABUL | TEMYIZ_ISTINAF |
  /// BOSANMA | NAFAKA | SIRKET_TEMSIL | TAHKIM | ARABULUCULUK | HACIZ_FEK |
  /// YEMIN_TEKLIF | DIGER değerlerinden gelir. Kapsam analizinin GİRDİSİDİR.
  scopeItemsJson String?
  /// Aktif mi — azil/istifa/süre dolumunda false'a çekilir. Portal erişimi ve
  /// dosya uyarı bandı BU alana bakar (revokedAt tek başına yeterli değil:
  /// süresi dolmuş vekaletname de pasiftir).
  isActive       Boolean   @default(true)
  /// Azil/istifa gerekçesi (serbest metin).
  revokeReason   String?
  /// Süre bitişi uyarısının gönderildiği an — 30/7/1 gün uyarılarının
  /// yinelenmesini engeller.
  warningSentAt  DateTime?

  scopeChecks PoaScopeCheck[]

  @@index([tenantId])
  @@index([clientId])
  @@index([tenantId, isActive])
  @@index([tenantId, expiresAt])
}

/// AI kapsam yeterlilik analizi (AI görev tipi POA_SCOPE_ANALYSIS, 10 kredi).
/// ÇIKTI ÖNERİDİR: verdict avukatı bağlamaz, dosyaya rapor olarak düşer.
model PoaScopeCheck {
  id                String          @id @default(uuid())
  tenantId          String
  powerOfAttorneyId String
  powerOfAttorney   PowerOfAttorney @relation(fields: [powerOfAttorneyId], references: [id], onDelete: Cascade)
  caseId            String
  case              Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Avukatın sorduğu özel soru (örn. "sulh teklifini kabul edebilir miyim?").
  question          String?
  verdict           PoaVerdict
  /// Eksik bulunan yetkiler (JSON dizi): [{ code, label, why }]
  missingPowersJson String?
  /// AI yorumu — "hukuki değerlendirme önerisidir, avukat teyidi gerekir".
  aiCommentary      String?
  model             String?
  checkedBy         String // User id
  checkedAt         DateTime        @default(now())

  @@index([tenantId, checkedAt])
  @@index([powerOfAttorneyId])
  @@index([caseId])
}

enum PoaVerdict {
  YETERLI
  YETERSIZ
  BELIRSIZ
}

// ---------- Finans ----------

enum FinancialEntryType {
  TAHAKKUK
  TAHSILAT
  AVANS
  MASRAF
  HARC
  VEKALET_UCRETI
  DANISMANLIK
  IADE
}

model FinancialEntry {
  id          String             @id @default(uuid())
  tenantId    String
  clientId    String?
  client      Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  caseId      String?
  case        Case?              @relation(fields: [caseId], references: [id], onDelete: SetNull)
  type        FinancialEntryType
  amount      Decimal            @db.Decimal(18, 2)
  currency    String             @default("TRY")
  date        DateTime           @default(now())
  description String?
  /// Faz 3 — bu kalem hangi faturaya aktarıldı (Invoice.id). İLİŞKİ DEĞİL, skaler:
  /// fatura silinse bile muhasebe kaydı ayakta kalmalıdır.
  invoiceId   String?
  /// Faturalanabilir mi (masraf/harç yansıtılmayacaksa false)
  isBillable  Boolean            @default(true)
  /// Kalem bazlı KDV oranı (%). null = KDV'siz / oran fatura satırında belirlenir.
  vatRate     Decimal?           @db.Decimal(5, 2)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([tenantId, date])
  @@index([clientId])
  @@index([caseId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, isBillable])
}

// ---------- AI katmanı (BYO-LLM) ----------

enum AiProviderType {
  ANTHROPIC
  OPENAI_COMPAT // OpenAI + Azure/OpenRouter/Groq/vLLM gibi uyumlu endpoint'ler
  OLLAMA
  GEMINI
  CUSTOM // Tamamen özel endpoint: header + alan eşlemesi kullanıcı tanımlı
}

model AiProviderConfig {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  name            String // Kullanıcının verdiği ad, örn. "Büro Claude hesabı"
  type            AiProviderType
  encryptedApiKey String? // AES-256-GCM ile şifreli (MASTER_ENCRYPTION_KEY)
  baseUrl         String? // OPENAI_COMPAT / OLLAMA / CUSTOM için
  defaultModel    String
  headersJson     String? // CUSTOM: ek header'lar (JSON)
  mappingJson     String? // CUSTOM: istek/yanıt alan eşlemesi (JSON)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  taskRoutes  AiTaskRoute[]
  aiUsageLogs AiUsageLog[]

  @@index([tenantId])
}

/// Görev tipi → sağlayıcı + model eşlemesi (görev başına model seçimi)
model AiTaskRoute {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  taskType         String // @nomosos/shared AI_TASK_TYPES değerlerinden
  providerConfigId String
  providerConfig   AiProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  model            String

  @@unique([tenantId, taskType])
}

model AiUsageLog {
  id               String            @id @default(uuid())
  tenantId         String
  userId           String?
  user             User?             @relation(fields: [userId], references: [id])
  providerConfigId String?
  providerConfig   AiProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  taskType         String
  model            String
  inputTokens      Int?
  outputTokens     Int?
  durationMs       Int?
  piiMasked        Boolean           @default(false) // Gönderim öncesi maskeleme uygulandı mı
  createdAt        DateTime          @default(now())

  /// Modül 26 — bu çağrıdan TAHSİL EDİLEN kredi. null = kredi hattı devrede
  /// değil (BYO-LLM tenant'ı) veya ücretsiz görev. 0 = kredili görev ama
  /// başarısız/boş yanıt nedeniyle mahsup yapılmadı.
  creditsCharged Int?
  /// İÇ MUHASEBE — kullanıcıya GÖSTERİLMEZ. ModelPrice üzerinden hesaplanan
  /// gerçek sağlayıcı maliyeti: (girdiToken/1M × girdiFiyat) + (çıktıToken/1M × çıktıFiyat).
  estimatedCost  Decimal? @db.Decimal(12, 4)
  /// estimatedCost'un para birimi (ModelPrice.currency'den kopyalanır, genelde "USD").
  costCurrency   String?

  @@index([tenantId, createdAt])
  @@index([tenantId, taskType, createdAt])
}

// ---------- Dilekçe üretimi ----------

enum PetitionType {
  DAVA_DILEKCESI
  CEVAP
  CEVABA_CEVAP
  IKINCI_CEVAP
  ISTINAF
  TEMYIZ
  ITIRAZ
  DELIL_LISTESI
  ISLAH
  BILIRKISI_ITIRAZ
  ICRA_TAKIP_TALEBI
  SIKAYET
  BEYAN
  DIGER
}

/// Dilekçe şablonu. tenantId null ise SİSTEM şablonudur (tüm bürolar görür).
/// DİKKAT: nullable tenantId nedeniyle @@unique([tenantId, key]) ile upsert YAPILAMAZ —
/// DeadlineRule'daki gibi findFirst + create/update deseni kullanılır.
model PetitionTemplate {
  id           String       @id @default(uuid())
  tenantId     String?
  key          String // Örn. "SISTEM_DAVA_DILEKCESI"
  name         String
  petitionType PetitionType
  /// Bölüm tanımları (JSON dizi): [{ title, hint?, required? }] — başlıklar
  /// packages/udf PETITION_SECTION_TITLES ile uyumludur.
  sectionsJson String
  isSystem     Boolean      @default(false)
  createdAt    DateTime     @default(now())

  petitions Petition[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([petitionType])
}

enum PetitionStatus {
  TASLAK
  TEYIT_EDILIYOR // Atıf/kaynak doğrulaması sürüyor
  TEYIT_EDILDI
  INCELEMEDE // Avukat incelemesi
  HAZIR
  DISA_AKTARILDI // UDF/PDF çıktısı alındı
  GONDERILDI
}

model Petition {
  id               String            @id @default(uuid())
  tenantId         String
  caseId           String
  case             Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  templateId       String?
  template         PetitionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  type             PetitionType
  title            String
  status           PetitionStatus    @default(TASLAK)
  /// Aktif sürüm (PetitionVersion.id) — ilişki kurulmaz, döngüyü önlemek için skaler.
  currentVersionId String?
  createdBy        String // User id
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  versions PetitionVersion[]

  @@index([tenantId, status])
  @@index([caseId, updatedAt])
}

/// Dilekçe sürümü — DEĞİŞTİRİLEMEZ (immutable). Her düzenleme yeni sürüm üretir.
model PetitionVersion {
  id           String   @id @default(uuid())
  petitionId   String
  petition     Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  versionNo    Int
  /// Bölüm gövdeleri (JSON): [{ title, body }]
  sectionsJson String
  /// Bölümlerden üretilen düz metin (UDF/PDF çıktısı ve atıf denetimi için)
  plainText    String
  createdBy    String // User id
  note         String?
  createdAt    DateTime @default(now())

  @@unique([petitionId, versionNo])
  @@index([petitionId, createdAt])
}

// ---------- İçtihat / mevzuat ----------

/// İçtihat kaydı — KİRACIDAN BAĞIMSIZ ortak havuz (tenantId YOKTUR).
/// Kiracıya özgü hiçbir veri buraya yazılmaz.
model CaseLawDocument {
  id                String    @id @default(uuid())
  court             String // Örn. "Yargıtay 9. Hukuk Dairesi"
  chamber           String?
  caseNumber        String // Esas no
  decisionNumber    String // Karar no
  decisionDate      DateTime?
  summary           String?
  fullText          String?
  sourceUrl         String?
  sourceAdapter     String // Kaydı getiren adaptör, örn. "SEED" | "UYAP" | "MANUEL"
  fetchedAt         DateTime  @default(now())
  /// Kaydı SİSTEME GİREN kiracı. null = kamusal/sistem kaydı (seed, resmî
  /// adaptörler) ve tüm bürolarca görülür.
  ///
  /// GÜVENLİK: Havuz ortaktır ama YAZMA ORTAK DEĞİLDİR. Bu alan olmadan
  /// (court, caseNumber, decisionNumber) upsert'i, B kiracısının A kiracısının
  /// girdiği emsalin metnini EZMESİNE (içerik zehirlenmesi) ve A'nın elle
  /// girdiği serbest metnin tüm kiracılara açılmasına imkân veriyordu.
  /// Elle girilen (MANUEL) kayıtlar yalnızca sahibine görünür ve yalnızca
  /// sahibi tarafından güncellenebilir.
  createdByTenantId String?

  references CaseLawReference[]

  @@unique([court, caseNumber, decisionNumber])
  @@index([court])
  @@index([decisionDate])
  @@index([createdByTenantId])
}

enum RefStatus {
  ADAY // AI önerisi — avukat henüz karar vermedi
  KABUL
  RED
}

/// Bir dosyaya iliştirilen içtihat atfı (kiracıya ait).
model CaseLawReference {
  id            String          @id @default(uuid())
  tenantId      String
  caseId        String
  case          Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseLawId     String
  caseLaw       CaseLawDocument @relation(fields: [caseLawId], references: [id], onDelete: Cascade)
  status        RefStatus       @default(ADAY)
  relevanceNote String?
  addedBy       String // User id
  createdAt     DateTime        @default(now())

  @@unique([caseId, caseLawId])
  @@index([tenantId, status])
  @@index([caseLawId])
}

enum CitationStatus {
  DOGRULANDI
  BULUNAMADI
  BELIRSIZ
}

/// AI çıktısındaki ham atıfların doğrulama izi (madde/içtihat uydurmasına karşı).
model CitationCheck {
  id          String         @id @default(uuid())
  tenantId    String
  sourceType  String // PETITION | CHAT | ANALYSIS
  sourceId    String
  rawCitation String // Metinden çıkarılan ham atıf, örn. "HMK m.317/2"
  status      CitationStatus
  note        String?
  checkedAt   DateTime       @default(now())

  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, status])
}

// ---------- AI Ajan Gözlemlenebilirliği (F2 · E1) ----------

/// Sistemdeki AI ajanının TANIMI — koddaki katalogdan (agent-catalog.ts) tohumlanır.
/// Tanım tablosu, "hangi ajan var, ne iş yapar" sorusunun tek kaynağıdır; kapatma
/// (aktif=false) yalnızca platform panelinden yapılır ve kod kataloğuyla ÇELİŞMEZ:
/// katalogda olmayan satır tohumlanmaz.
model AgentDefinition {
  id          String  @id @default(uuid())
  /// Koddaki katalog anahtarı — değişmez (örn. "ICTIHAT_ARASTIRMA").
  agentKey    String  @unique
  /// Görev tipi — @nomosos/shared AI_TASK_TYPES değerlerinden.
  taskType    String
  name        String
  description String
  /// Katalogda tanımlı mı (kod silinirse tanım tohumlanmaz, satır kalır)?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
}

/// Bir ajan KOŞUSU — her LLM çağrısı için tek satır (F2 · E1).
/// AiUsageLog İÇ MUHASEBE (token/kredi) içindir; AgentRun İZDİR: ajan kim,
/// ne zaman, hangi girdiyle, hangi durumla döndü. input/output ÖZET taşır —
/// tam metin ASLA yazılmaz (KVKK: maskeleme öncesi metin kayda girmez).
model AgentRun {
  id          String   @id @default(uuid())
  tenantId    String
  agentKey    String
  taskType    String
  /// BASARILI | BASARISIZ | REDDEDILDI (çıktı guard'ı eledi).
  status      String
  userId      String?
  /// Çağrının bağlandığı iş kaydı (örn. dosya kimliği) — varsa.
  entity      String?
  entityId     String?
  model       String?
  providerType String?
  inputTokens  Int?
  outputTokens Int?
  durationMs   Int?
  piiMasked    Boolean  @default(false)
  /// Girdi ÖZETİ (JSON): alan adları + uzunluklar + maskelenmiş kısa alıntı.
  inputSummaryJson  String?
  /// Çıktı ÖZETİ (JSON): şema geçtiyse anahtar alanlar.
  outputSummaryJson String?
  errorMessage String?
  createdAt   DateTime @default(now())

  @@index([tenantId, agentKey, createdAt])
  @@index([tenantId, taskType, createdAt])
  @@index([tenantId, status, createdAt])
}

// ---------- Denetim ----------

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  action    String // Örn. "CLIENT_CREATE", "AI_CHAT", "DOCUMENT_DOWNLOAD"
  entity    String? // Etkilenen entity adı
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ===========================================================================
// FAZ 3 — A) İCRA TAKİBİ (docs/moduller/05-icra-modulu.md)
// ===========================================================================
// PARA: tüm tutarlar Decimal(18,2). Hesaplarda JS float KULLANILMAZ;
// Prisma.Decimal veya tamsayı kuruş aritmetiği zorunludur.

/// İcra takibinin türü (İİK)
enum EnforcementType {
  ILAMLI
  ILAMSIZ
  KAMBIYO
  REHNIN_PARAYA_CEVRILMESI
  IPOTEGIN_PARAYA_CEVRILMESI
  NAFAKA
  TAHLIYE
}

/// Takibin bulunduğu aşama — safahat ilerledikçe güncellenir.
enum EnforcementStage {
  TAKIP_TALEBI
  ODEME_EMRI_TEBLIG
  ITIRAZ
  ITIRAZIN_KALDIRILMASI
  KESINLESME
  HACIZ
  SATIS
  TAHSILAT
  ACIZ_VESIKASI
  KAPANDI
}

/// İcra dosyası — bir Case kaydının icra uzantısıdır (1:1).
/// Dosya (Case) silinirse icra uzantısı da silinir.
model EnforcementFile {
  id                   String           @id @default(uuid())
  tenantId             String
  /// Bir icra dosyası tam olarak bir Case'e bağlıdır.
  caseId               String           @unique
  case                 Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  officeName           String // İcra dairesi, örn. "İstanbul 9. İcra Dairesi"
  fileNumber           String // Örn. "2026/1234"
  trackingType         EnforcementType
  stage                EnforcementStage @default(TAKIP_TALEBI)
  /// Asıl alacak (takip çıkışındaki ana para)
  principalAmount      Decimal          @db.Decimal(18, 2)
  /// Yıllık faiz oranı (%). Faiz hesabı DETERMİNİSTİKTİR, AI hesaplamaz.
  interestRate         Decimal?         @db.Decimal(5, 2)
  currency             String           @default("TRY")
  requestDate          DateTime // Takip talebi tarihi
  /// FAİZ BAŞLANGICI — temerrüt/vade/ihtar tarihi. Takip talebinde faiz
  /// genellikle takip tarihinden ÖNCE bir tarihten istenir; boş bırakılırsa
  /// hesap `requestDate`'ten işletilir ve bakiye yanıtında UYARI döner.
  /// Varsayılan bir tarih UYDURULMAZ; tarih avukatın beyanıdır.
  interestStartDate    DateTime?
  paymentOrderServedAt DateTime? // Ödeme emri tebliğ tarihi — süre motorunun çapası
  objectionDate        DateTime? // Borçlu itiraz tarihi
  finalizedAt          DateTime? // Takibin kesinleştiği tarih
  closedAt             DateTime?
  /// Borçluya dair serbest metin (unvan/adres/vergi no). KVKK: dış LLM'e
  /// giderken packages/ai scanPii/maskText uygulanır.
  debtorInfo           String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  actions     EnforcementAction[]
  assets      AssetRecord[]
  collections CollectionRecord[]
  scores      CollectionScore[]

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, requestDate])
  @@index([tenantId, fileNumber])
}

/// İcra dosyasındaki işlem türü
enum EnforcementActionType {
  TAKIP_TALEBI
  ODEME_EMRI
  ITIRAZ
  ITIRAZIN_IPTALI
  HACIZ_TALEBI
  HACIZ_UYGULAMA
  KIYMET_TAKDIRI
  SATIS_TALEBI
  IHALE
  TAHSILAT
  HARC_ODEME
  MASRAF
  DIGER
}

/// İcra safahatı — dosyada yapılan her işlemin kaydı.
model EnforcementAction {
  id                String                @id @default(uuid())
  tenantId          String
  enforcementFileId String
  enforcementFile   EnforcementFile       @relation(fields: [enforcementFileId], references: [id], onDelete: Cascade)
  type              EnforcementActionType
  date              DateTime
  description       String
  /// Harç/masraf/tahsilat gibi parasal işlemlerde tutar
  amount            Decimal?              @db.Decimal(18, 2)
  resultNote        String?
  createdBy         String // User id
  createdAt         DateTime              @default(now())

  @@index([enforcementFileId, date])
  @@index([tenantId, date])
  @@index([tenantId, type])
}

enum AssetType {
  TASINMAZ
  ARAC
  BANKA_HESABI
  MAAS
  ALACAK
  HISSE
  DIGER
}

enum AssetStatus {
  TESPIT_EDILDI
  HACZEDILDI
  SATISA_CIKARILDI
  SATILDI
  SERBEST_BIRAKILDI
}

/// Borçlu malvarlığı kaydı (UYAP/banka/tapu sorgu sonuçları).
/// KVKK: hesap no / plaka gibi alanlar description içinde maskeli gösterilir.
model AssetRecord {
  id                String          @id @default(uuid())
  tenantId          String
  enforcementFileId String
  enforcementFile   EnforcementFile @relation(fields: [enforcementFileId], references: [id], onDelete: Cascade)
  assetType         AssetType
  description       String
  estimatedValue    Decimal?        @db.Decimal(18, 2)
  status            AssetStatus     @default(TESPIT_EDILDI)
  discoveredAt      DateTime
  note              String?

  @@index([enforcementFileId])
  @@index([tenantId, status])
  @@index([tenantId, assetType])
}

enum CollectionMethod {
  BANKA
  KASA
  HACIZ_SATIS
  MAAS_KESINTISI
  ANLASMA
  DIGER
}

/// İcra dosyasında yapılan tahsilat. Bakiye hesabı deterministiktir.
model CollectionRecord {
  id                String           @id @default(uuid())
  tenantId          String
  enforcementFileId String
  enforcementFile   EnforcementFile  @relation(fields: [enforcementFileId], references: [id], onDelete: Cascade)
  amount            Decimal          @db.Decimal(18, 2)
  date              DateTime
  method            CollectionMethod
  note              String?
  createdBy         String // User id
  createdAt         DateTime         @default(now())

  @@index([enforcementFileId, date])
  @@index([tenantId, date])
}

enum ScoreBand {
  DUSUK
  ORTA
  YUKSEK
}

/// Tahsilat ihtimali skoru — DEĞİŞTİRİLEMEZ, her hesap yeni kayıttır.
/// Skor KURAL TABANLI sinyallerden üretilir (ruleSignalsJson); AI yalnızca
/// yorum yazar (aiCommentary). AI TEK BAŞINA PARASAL KARAR VERMEZ.
model CollectionScore {
  id                String          @id @default(uuid())
  tenantId          String
  enforcementFileId String
  enforcementFile   EnforcementFile @relation(fields: [enforcementFileId], references: [id], onDelete: Cascade)
  /// 0-100 — KURAL TABANI + AI düzeltmesi (±15) uygulanmış NİHAİ skor.
  score             Int
  /// Bant DAİMA `baseScore`'dan türer; AI düzeltmesi bandı DEĞİŞTİREMEZ.
  /// Skor ile bant çeliştiğinde (ör. 54 / DUSUK) doğru olan banttır; ayrımın
  /// kaynağı `baseScore` + `aiAdjustment` alanlarında saklıdır.
  band              ScoreBand
  /// AI etkisi UYGULANMADAN ÖNCEKİ kural skoru — bandın gerçek dayanağı.
  baseScore         Int?
  /// AI'ın skora katkısı (-15..+15). Bandı etkilemez.
  aiAdjustment      Int?
  /// Bandın nereden geldiği: "TABAN_SKOR" (tek geçerli değer; kayıt için).
  bandSource        String?
  /// Deterministik sinyaller (JSON): [{ key, label, weight, value, contribution }]
  ruleSignalsJson   String
  /// AI yorumu — öneri niteliğindedir, skoru DEĞİŞTİRMEZ
  aiCommentary      String?
  model             String?
  computedAt        DateTime        @default(now())
  computedBy        String? // User id — sistem hesaplarında null

  @@index([tenantId, enforcementFileId, computedAt])
  @@index([enforcementFileId, computedAt])
}

// ===========================================================================
// FAZ 3 — B) FİNANS & FATURALAMA (docs/moduller/08, 09)
// ===========================================================================

enum FeeType {
  SABIT
  SAATLIK
  BASARI_PRIMI
  DOSYA_BAZLI
  AYLIK_DANISMANLIK
  KARMA
}

enum AgreementStatus {
  TASLAK
  AKTIF
  SONA_ERDI
  FESIH
}

/// Avukatlık ücret sözleşmesi. KDV oranı ALAN olarak tutulur (koda gömülmez);
/// varsayılan %20'dir, sözleşme bazında değiştirilebilir.
model FeeAgreement {
  id             String          @id @default(uuid())
  tenantId       String
  clientId       String
  client         Client          @relation(fields: [clientId], references: [id])
  caseId         String?
  case           Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  type           FeeType
  /// SABIT / DOSYA_BAZLI / AYLIK_DANISMANLIK tutarı
  amount         Decimal?        @db.Decimal(18, 2)
  /// SAATLIK sözleşmelerde saat ücreti
  hourlyRate     Decimal?        @db.Decimal(18, 2)
  /// BASARI_PRIMI yüzdesi (%)
  successPercent Decimal?        @db.Decimal(5, 2)
  currency       String          @default("TRY")
  /// KDV oranı (%) — sabit değil, sözleşme alanıdır
  vatRate        Decimal         @default(20) @db.Decimal(5, 2)
  startDate      DateTime
  endDate        DateTime?
  terms          String?
  status         AgreementStatus @default(TASLAK)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([clientId])
  @@index([caseId])
  @@index([tenantId, startDate])
}

/// Zaman kaydı (billable hours). minutes TAMSAYIDIR — dakika üzerinden
/// hesaplanır, saate çevrim yalnız gösterimde/faturalamada yapılır.
model TimeEntry {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  date        DateTime
  minutes     Int
  description String
  billable    Boolean  @default(true)
  /// Kayıt anındaki saat ücreti (sözleşme sonradan değişse de fatura sabit kalır)
  hourlyRate  Decimal? @db.Decimal(18, 2)
  /// Faturalandıysa Invoice.id — İLİŞKİ DEĞİL, skaler (fatura iptalinde
  /// zaman kaydı silinmez, alan boşaltılır).
  invoiceId   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, date])
  @@index([userId, date])
  @@index([caseId])
  @@index([clientId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, billable, date])
}

enum InvoiceStatus {
  TASLAK
  GONDERILDI
  KISMI_ODENDI
  ODENDI
  IPTAL
  IADE
}

/// e-Fatura durumu. GİB'e GERÇEK BAĞLANTI YOKTUR — NoopEInvoiceAdapter
/// kaydı YOK/BEKLIYOR'da bırakır ve "entegratör yapılandırılmamış" der.
enum EInvoiceStatus {
  YOK
  BEKLIYOR
  GONDERILDI
  KABUL
  RED
  IPTAL
}

/// Müvekkil faturası (tenant içi). Toplamlar Decimal aritmetiğiyle hesaplanır;
/// subtotal + vatAmount = total değişmezi uygulama katmanında korunur.
model Invoice {
  id             String         @id @default(uuid())
  tenantId       String
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id])
  /// Seri-sıra no, örn. "NOM2026000001". TASLAK aşamasında null olabilir;
  /// Postgres'te NULL'lar birbirinden farklı sayıldığı için birden çok
  /// numarasız taslak @@unique([tenantId, invoiceNo]) ile çakışmaz.
  invoiceNo      String?
  /// Belge türü (rakip analizi — A6): avukatın serbest meslek makbuzu
  /// (e-SMM) ile faturası (e-Fatura/e-Arşiv) AYRI belge türleridir.
  documentType   InvoiceDocType @default(FATURA)
  issueDate      DateTime
  dueDate        DateTime?
  subtotal       Decimal        @db.Decimal(18, 2)
  vatAmount      Decimal        @db.Decimal(18, 2)
  total          Decimal        @db.Decimal(18, 2)
  currency       String         @default("TRY")
  status         InvoiceStatus  @default(TASLAK)
  eInvoiceStatus EInvoiceStatus @default(YOK)
  eInvoiceUuid   String?
  note           String?
  createdBy      String // User id
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lines    InvoiceLine[]
  payments Payment[]
  /// Portal ödeme bağlantıları (rakip analizi — E8).
  odemeLinkileri OdemeLinki[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, status])
  @@index([tenantId, issueDate])
  @@index([clientId])
  @@index([tenantId, eInvoiceStatus])
}

/// Belge türü (A6): e-Fatura/e-Arşiv mi e-SMM mi — GİB'e gönderim kanalı
/// ve UBL eşlemesi türe göre ayrışır.
enum InvoiceDocType {
  FATURA
  E_SMM
}

/// Fatura satırı. lineTotal = quantity * unitPrice (KDV hariç) — Decimal ile
/// hesaplanır, JS float ile DEĞİL.
model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(18, 2)
  vatRate     Decimal @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(18, 2)
  /// TIME_ENTRY | FEE_AGREEMENT | EXPENSE | MANUEL — satırın nereden geldiği
  sourceType  String?
  /// Kaynak kaydın id'si (TimeEntry.id / FeeAgreement.id / FinancialEntry.id)
  sourceId    String?
  /// F2-Ö-18: Grup satırının temsil ettiği zaman kaydı id'leri (JSON dizi).
  /// `createFromTimeEntries` grup satırlarında doldurur; satır faturadan
  /// çıkarıldığında hangi kayıtların serbest bırakılacağı buradan bilinir
  /// (sourceId=null olduğu için serbest bırakma kaynağı belli olmuyordu).
  sourceIdsJson String?

  @@index([invoiceId])
  @@index([sourceType, sourceId])
}

enum PaymentMethod {
  HAVALE
  KREDI_KARTI
  NAKIT
  CEK
  SENET
  MAHSUP
  /// Portal ödeme bağlantısından gelen online tahsilat (rakip analizi — E8).
  ONLINE
  DIGER
}

/// Müvekkilden alınan tahsilat (tenant içi). Platform aboneliği tahsilatı
/// AYRI modeldir: PaymentRecord.
model Payment {
  id        String        @id @default(uuid())
  tenantId  String
  invoiceId String?
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
  amount    Decimal       @db.Decimal(18, 2)
  /// Tahsilatın para birimi (denetim bulgusu Ö-14).
  ///
  /// Eskiden bu kolon YOKTU ve `payments.service.ts` faturasız tahsilatı
  /// KOŞULSUZ "TRY" sayıyordu: EUR sözleşmeli müvekkilden alınan 5.000 EUR,
  /// `FinancialEntry(TAHSILAT)` kaydına 5.000 TRY olarak düşüyor, TRY alacağını
  /// 5.000 azaltıp müvekkilin EUR bakiyesini hiç düşürmüyordu.
  ///
  /// Faturaya bağlı tahsilatta fatura para birimiyle EŞLEŞMESİ zorunludur
  /// (uyuşmazsa 400); serbest tahsilatta çağıran açıkça belirtir.
  currency  String        @default("TRY")
  date      DateTime
  method    PaymentMethod
  reference String? // Dekont / işlem referansı
  note      String?
  createdBy String // User id
  createdAt DateTime      @default(now())

  @@index([tenantId, date])
  @@index([invoiceId])
  @@index([clientId])
  @@index([tenantId, method])
}

// ===========================================================================
// FAZ 3 — C) PLATFORM / SİSTEM YÖNETİM PANELİ (docs/moduller/25)
// ===========================================================================
// PlatformUser, tenant User'dan TAMAMEN AYRIDIR: ayrı login, ayrı guard,
// JWT payload { sub, role, aud: "platform" }. Platform tabloları tenantId'yi
// SKALER tutar (Tenant'a FK YOKTUR) — denetim ve faturalama kayıtları,
// tenant silinse dahi ayakta kalmalıdır.

enum PlatformRole {
  SUPER_ADMIN
  OPS_ADMIN
  BILLING_ADMIN
  SUPPORT_AGENT
  ANALYST_READONLY
}

/// Platform yöneticisi. Tenant User tablosuyla HİÇBİR ilişkisi yoktur;
/// e-posta uzayları da ayrıdır.
model PlatformUser {
  id              String       @id @default(uuid())
  email           String       @unique
  passwordHash    String
  fullName        String
  role            PlatformRole
  isActive        Boolean      @default(true)
  /// TOTP gizli anahtarı — AES-256-GCM ile şifreli saklanır (MASTER_ENCRYPTION_KEY).
  /// ASLA düz metin dönülmez; yalnız kurulum anında QR üretiminde kullanılır.
  twoFactorSecret String?
  /// SON KULLANILAN TOTP ADIMI — tekrar oynatma koruması (denetim bulgusu İ-01).
  /// `window: 1` saat kayması toleransı verir; bu sütun olmadan AYNI kod
  /// 90 saniye boyunca tekrar tekrar kabul edilirdi. Bu adımdan küçük/eşit
  /// hiçbir sayaç kabul edilmez; 2FA sıfırlanınca null'lanır.
  lastTotpCounter Int?
  lastLoginAt     DateTime?
  /// OTURUM SÜRÜMÜ. Panel token'ı `tv` alanında bu değeri taşır; guard
  /// eşleşmeyeni reddeder. Parola değişimi, 2FA sıfırlama ve rol düşürme bu
  /// sayacı artırır → ele geçirilmiş oturum ANINDA düşer (spec §Güvenlik 3).
  tokenVersion    Int          @default(0)
  /// Ardışık başarısız giriş/2FA denemesi. 5'te hesap kilitlenir.
  failedAttempts  Int          @default(0)
  /// HATA PENCERESİ SONU (İ-01): pencere dolmuşsa sayaç yeniden başlar —
  /// aylara yayılan seyrek hatalar hesabı kilitlenmez (tenant tarafıyla
  /// aynı davranış; bkz. common/account-lockout.ts).
  failureWindowEndsAt DateTime?
  /// Başarısız deneme sınırına ulaşınca hesap bu zamana kadar kilitlenir.
  lockedUntil     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  supportGrants SupportAccessGrant[]

  @@index([role])
  @@index([isActive])
}

/// Abonelik planı tanımı (SOLO | BURO | ENTERPRISE)
model PlanTier {
  id                  String   @id @default(uuid())
  key                 String   @unique // SOLO | BURO | ENTERPRISE
  name                String
  monthlyPricePerUser Decimal? @db.Decimal(18, 2)
  maxUsers            Int? // null = sınırsız
  /// Özellik listesi (JSON): { "aiCallQuota": 5000, "modules": [...] }
  featuresJson        String
  isActive            Boolean  @default(true)

  @@index([isActive])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

/// Tenant aboneliği — tenant başına tek kayıt.
/// planKey değişimi ve askıya alma DÖRT-GÖZ onayına tabidir
/// (PlatformApprovalRequest üzerinden yürür).
model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  planKey            String // PlanTier.key — skaler (plan silinse abonelik ayakta kalır)
  status             SubscriptionStatus @default(TRIAL)
  seats              Int                @default(1)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  note               String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payments PaymentRecord[]

  @@index([status])
  @@index([planKey])
  @@index([currentPeriodEnd])
}

enum PlatformPaymentStatus {
  BEKLIYOR
  BASARILI
  BASARISIZ
  IADE
}

/// PLATFORM tahsilatı (büronun NomosOS aboneliğine ödediği para).
/// Tenant'ın müvekkilinden aldığı Payment ile KARIŞTIRILMAZ.
model PaymentRecord {
  id             String                @id @default(uuid())
  tenantId       String
  subscriptionId String?
  subscription   Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount         Decimal               @db.Decimal(18, 2)
  currency       String                @default("TRY")
  status         PlatformPaymentStatus @default(BEKLIYOR)
  method         String? // Ödeme sağlayıcısı yöntemi (serbest metin)
  providerRef    String? // Sağlayıcı işlem referansı
  paidAt         DateTime?
  failureReason  String?
  createdAt      DateTime              @default(now())

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@index([subscriptionId])
}

/// PLATFORM faturası (NomosOS → büro). Tenant'ın kendi Invoice'ından ayrıdır.
model InvoiceRecord {
  id        String        @id @default(uuid())
  tenantId  String
  number    String? // Platform fatura numarası
  amount    Decimal       @db.Decimal(18, 2)
  vatAmount Decimal       @db.Decimal(18, 2)
  total     Decimal       @db.Decimal(18, 2)
  issueDate DateTime
  status    InvoiceStatus @default(TASLAK)
  pdfKey    String? // S3/MinIO nesne anahtarı
  createdAt DateTime      @default(now())

  @@unique([number])
  @@index([tenantId, issueDate])
  @@index([status])
}

/// Çalışma zamanı sistem ayarı (bakım modu, kota varsayılanları vb.)
model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  valueJson   String
  description String?
  updatedBy   String? // PlatformUser id
  updatedAt   DateTime @default(now()) @updatedAt
}

/// Özellik bayrağı. Global açık değilse enabledTenantIdsJson listesindeki
/// kiracılarda açıktır (JSON string dizisi).
model FeatureFlag {
  id                   String   @id @default(uuid())
  key                  String   @unique
  description          String?
  isEnabledGlobally    Boolean  @default(false)
  /// JSON string dizisi: ["tenantId1", "tenantId2"]
  enabledTenantIdsJson String?
  updatedBy            String? // PlatformUser id
  updatedAt            DateTime @default(now()) @updatedAt
}

enum AnnouncementSeverity {
  BILGI
  UYARI
  KRITIK
}

enum AnnouncementAudience {
  TUM
  PLAN_BAZLI
  TENANT_BAZLI
}

/// Platform duyurusu (bakım, sürüm notu, kritik uyarı).
model Announcement {
  id          String               @id @default(uuid())
  title       String
  body        String
  severity    AnnouncementSeverity @default(BILGI)
  audience    AnnouncementAudience @default(TUM)
  /// Hedef (JSON): PLAN_BAZLI → { "planKeys": [...] }, TENANT_BAZLI → { "tenantIds": [...] }
  targetJson  String?
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String // PlatformUser id
  createdAt   DateTime             @default(now())

  @@index([publishedAt])
  @@index([severity])
}

/// Platform tarafı denetim izi. Tenant AuditLog'undan AYRIDIR.
/// Destek erişimi gibi işlemler HER İKİSİNE birden yazılır.
model PlatformAuditLog {
  id             String        @id @default(uuid())
  /// Kim İŞLEMİ yaptı — FK DEĞİLDİR (denetim bulgusu Ö-27 kalıntısı).
  /// `tenantId` ile aynı desen: platform kullanıcısı hard delete edilse dahi
  /// iz AYAKTA KALIR. FK olsaydı `onDelete: SetNull` denetim satırlarında
  /// UPDATE koşar ve append-only trigger'ı silme işlemini TAMAMEN BLOKLARDI.
  platformUserId String?
  action         String // Örn. "TENANT_SUSPEND", "SUPPORT_GRANT_CREATE"
  entity         String?
  entityId       String?
  tenantId       String? // İlgili kiracı — FK YOK (kiracı silinse iz kalır)
  detail         String?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@index([platformUserId])
  @@index([tenantId])
  @@index([action, createdAt])
}

/// Günlük tenant kullanım fotoğrafı. ANALYST_READONLY yalnızca bu tür
/// TOPLULAŞTIRILMIŞ sayıları görebilir; müvekkil/dosya/belge içeriğini göremez.
model UsageSnapshot {
  id             String   @id @default(uuid())
  tenantId       String
  /// Gün hassasiyetli (@db.Date) — saat dilimi kaymasını önler
  date           DateTime @db.Date
  activeUsers    Int      @default(0)
  caseCount      Int      @default(0)
  documentCount  Int      @default(0)
  aiCallCount    Int      @default(0)
  aiInputTokens  Int      @default(0)
  aiOutputTokens Int      @default(0)
  /// DİKKAT: BigInt — JSON.stringify doğrudan SERİLEŞTİREMEZ.
  /// API katmanında Number()/String()'e çevrilerek dönülmelidir.
  storageBytes   BigInt?
  createdAt      DateTime @default(now())

  @@unique([tenantId, date])
  @@index([date])
  @@index([tenantId, date])
}

/// Destek erişim kapsamı. IMPERSONATION YASAKTIR — destek personeli
/// kullanıcı kimliğine bürünemez, yalnız kapsamlı ve süreli erişim alır.
enum SupportScope {
  SADECE_USTVERI // Yalnız sayılar/üstveri
  YAPILANDIRMA // Ayarlar, sağlayıcı yapılandırması (içerik yok)
  ICERIK_MASKELI // İçerik görünür ama PII maskeli
}

/// Süreli destek erişim yetkisi. Gerekçe ZORUNLU, varsayılan 4 saat,
/// AZAMİ 24 saat. Oluşturma ve iptal hem PlatformAuditLog'a hem ilgili
/// tenant'ın AuditLog'una yazılır.
model SupportAccessGrant {
  id             String       @id @default(uuid())
  tenantId       String
  platformUserId String
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  reason         String
  scope          SupportScope @default(SADECE_USTVERI)
  grantedAt      DateTime     @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedBy      String? // PlatformUser id

  @@index([tenantId, expiresAt])
  @@index([platformUserId, expiresAt])
  @@index([expiresAt])
}

enum ApprovalStatus {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
  SURESI_DOLDU
}

/// DÖRT-GÖZ onay talebi. Plan değiştirme, tenant askıya alma, iade, tenant
/// silme gibi işlemler doğrudan yapılmaz. TALEP EDEN KENDİ TALEBİNİ ONAYLAYAMAZ
/// (decidedBy != requestedBy sunucuda zorlanır). 72 saat zaman aşımı.
model PlatformApprovalRequest {
  id           String         @id @default(uuid())
  requestedBy  String // PlatformUser id
  action       String // Örn. "TENANT_SUSPEND", "SUBSCRIPTION_PLAN_CHANGE", "REFUND"
  /// İşlem parametreleri (JSON) — onaylandığında bu payload uygulanır
  payloadJson  String
  tenantId     String?
  status       ApprovalStatus @default(BEKLIYOR)
  decidedBy    String? // PlatformUser id — requestedBy ile AYNI OLAMAZ
  decidedAt    DateTime?
  decisionNote String?
  expiresAt    DateTime // Oluşturma + 72 saat
  createdAt    DateTime       @default(now())

  @@index([status, expiresAt])
  @@index([requestedBy])
  @@index([tenantId])
  @@index([createdAt])
}

// ===========================================================================
// FAZ 4 — A) STRATEJİ MOTORU (docs/moduller/15-strateji-motoru.md)
// ===========================================================================
// ÜRÜN İLKESİ: strateji ağacı bir ÖNERİDİR. Hiçbir düğüm kendiliğinden
// Task/Deadline/Petition kaydına dönüşmez; avukat aktarımı açıkça onaylar.

enum StrategyStatus {
  TASLAK /// Henüz yayına alınmamış ilk taslak
  GUNCEL /// Yayındaki sürüm dosyanın bugünkü haliyle uyumlu
  BAYAT /// Dosyada yeni olay var; strateji yeniden üretilmeli
}

/// Dosyanın 9 halkalı argüman zinciri. Gövde `StrategyVersion.treeJson`
/// içindedir; `StrategyNode` aynı ağacın sorgulanabilir normalize kopyasıdır.
model Strategy {
  id       String @id @default(uuid())
  tenantId String
  caseId   String
  case     Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title    String

  status StrategyStatus @default(TASLAK)

  /// Yayındaki sürüm (StrategyVersion.id). Petition/currentVersionId ile aynı
  /// gerekçeyle SKALER tutulur: iki yönlü zorunlu ilişki döngü yaratır.
  currentVersionId String?

  createdBy String // User id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions StrategyVersion[]
  nodes    StrategyNode[]

  @@index([tenantId, status])
  @@index([caseId, updatedAt])
}

/// Strateji sürümü — DEĞİŞTİRİLEMEZ (immutable). Her yeniden üretim yeni
/// sürümdür; eski sürüm "o gün ne düşünmüştük" sorusunun kanıtıdır.
model StrategyVersion {
  id         String   @id @default(uuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  versionNo  Int
  /// Ağacın tam anlık görüntüsü (JSON):
  /// { nodes: [{ id, nodeType, content, strength, sourceRef, children: [...] }], generatedAt, model }
  treeJson   String
  /// Bu sürümde ne değişti — AI üretir, avukat düzenleyebilir.
  summary    String?
  model      String? // Üreten model; elle yazılan sürümlerde null
  createdBy  String // User id
  createdAt  DateTime @default(now())

  @@unique([strategyId, versionNo])
  @@index([strategyId, createdAt])
}

enum StrategyNodeType {
  KARSI_ARGUMAN
  BIZIM_ARGUMAN
  DELIL
  HUKUKI_DAYANAK
  ZAYIF_NOKTA
  KARSI_CEVAP
  SENARYO
  RISK
}

/// Ağacın normalize düğümü — filtreleme/raporlama için. Gövde kaynağı
/// StrategyVersion.treeJson'dır; bu tablo ondan türetilir.
model StrategyNode {
  id         String           @id @default(uuid())
  tenantId   String
  strategyId String
  strategy   Strategy         @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     StrategyNode?    @relation("StrategyNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   StrategyNode[]   @relation("StrategyNodeTree")
  nodeType   StrategyNodeType
  content    String
  /// Argüman gücü 1-5 (uygulama katmanında sınırlanır; 1 = çok zayıf).
  strength   Int?
  /// Dayanak izi: "DOC:<documentId>" | "CASELAW:<id>" | "MEVZUAT:TBK m.112".
  /// Atıflar KAYIT ÜZERİNDEN doğrulanır; LLM'e "bu karar var mı" sorulmaz.
  sourceRef  String?
  orderIndex Int              @default(0)
  createdAt  DateTime         @default(now())

  @@index([tenantId, strategyId])
  @@index([strategyId, parentId, orderIndex])
}

// ===========================================================================
// FAZ 4 — B) SİMÜLASYON MODLARI (docs/moduller/16-simulasyon-modlari.md)
// ===========================================================================

enum SimulationMode {
  KARSI_TARAF_AVUKATI /// "Karşı taraf avukatı olsam ne yapardım"
  HAKIM_GOZU /// Hakim gözüyle dosyanın zayıf/güçlü yanları
  KAYBETTIREN_HUSUSLAR /// Bu davayı kaybettirecek hususlar
  KARSI_DILEKCE_ZAYIFLIK /// Karşı dilekçedeki zayıf noktalar
  BILIRKISI_ODAGI /// Bilirkişinin odaklanacağı teknik noktalar
}

/// Bir simülasyon koşusu. `inputSnapshotJson` TEKRARLANABİLİRLİK içindir:
/// koşuya hangi belge/strateji sürümünün girdiği kayıt altındadır; aksi halde
/// aynı komut ay sonra bambaşka bir sonuç üretir ve çıktı savunulamaz.
model SimulationRun {
  id                String         @id @default(uuid())
  tenantId          String
  caseId            String
  case              Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  mode              SimulationMode
  /// Girdi künyesi (JSON): { documentIds, strategyVersionId?, params, generatedAt }
  inputSnapshotJson String
  /// Mod şemasına uygun çıktı (JSON): { findings: [{ rank, title, body, severity, sourceRefs }] }
  outputJson        String
  model             String?
  durationMs        Int?
  createdBy         String // User id
  createdAt         DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@index([caseId, mode, createdAt])
}

// ===========================================================================
// FAZ 4 — C) RİSK MOTORU (docs/moduller/17-risk-motoru.md)
// ===========================================================================
// HİBRİT KURAL: taban skoru DETERMİNİSTİK sinyaller üretir (ruleSignalsJson),
// AI yalnız sınırlı düzeltme (±25) önerir ve BANDI TEK BAŞINA DEĞİŞTİREMEZ —
// CollectionScore'daki ilkenin aynısı.

enum RiskDimension {
  GENEL /// Ağırlıklı bileşke
  HUKUKI
  SURE
  DELIL
  TAHSILAT
  USUL
  ICTIHAT
  KARSI_TARAF
}

enum RiskBand {
  DUSUK
  ORTA
  YUKSEK
}

/// Dosya × boyut başına GÜNCEL skor (tek satır; geçmiş RiskScoreHistory'de).
model RiskScore {
  id              String        @id @default(uuid())
  tenantId        String
  caseId          String
  case            Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  dimension       RiskDimension
  /// 0-100 — kural tabanı + AI düzeltmesi uygulanmış NİHAİ skor.
  score           Int
  /// 0-100 — YALNIZ deterministik kural sinyallerinden gelen taban.
  /// SAKLANIR, `score - aiAdjustment` ile GERİ HESAPLANMAZ: 0-100 kırpması
  /// devreye girdiğinde (taban 85 + AI 25 → skor 100) ters çevirme yanlış
  /// sonuç verir ve avukata deterministik tabanı olduğundan düşük gösterirdi.
  /// Sütun öncesi satırlarda null'dur; okuyucu o durumda geri hesaba düşer.
  baseScore       Int?
  /// Bant DAİMA kural tabanından türer; AI düzeltmesi bandı değiştirmez.
  band            RiskBand
  /// Deterministik sinyaller (JSON): [{ key, label, weight, value, contribution }]
  ruleSignalsJson String
  /// AI'ın skora katkısı (-25..+25). Bandı etkilemez.
  aiAdjustment    Int?
  /// AI yorumu — ÖNERİDİR, skoru tek başına belirlemez.
  aiCommentary    String?
  model           String?
  computedAt      DateTime      @default(now())
  computedBy      String? // User id — gece hesabında null

  @@unique([caseId, dimension])
  @@index([tenantId, dimension, band])
  @@index([tenantId, computedAt])
}

/// Append-only zaman serisi — risk eğrisi ve "ne zaman kızardı" sorusu için.
/// GÜNCELLENMEZ, SİLİNMEZ.
model RiskScoreHistory {
  id              String        @id @default(uuid())
  tenantId        String
  caseId          String
  dimension       RiskDimension
  score           Int
  /// Deterministik kural tabanı (bkz. RiskScore.baseScore).
  baseScore       Int?
  band            RiskBand
  ruleSignalsJson String
  aiAdjustment    Int?
  computedAt      DateTime      @default(now())

  @@index([tenantId, caseId, dimension, computedAt])
  @@index([caseId, computedAt])
}

/// Gece risk işinin kiracı günlük fotoğrafı (F2 · E2). Ortak paneli (E4) ve
/// büro panelini, her istekte yüzlerce RiskScore satırını toplayan canlı
/// sorgudan kurtarır: dashboard açılışı TEK satırdan okunur.
model DashboardSnapshot {
  id     String @id @default(uuid())
  tenantId String
  /// Fotoğrafın hangi GÜNE ait olduğu (TR takvimi; yyyy-mm-dd).
  date   String
  /// Fotoğrafa giren AKTİK dosya sayısı.
  caseCount Int
  /// GENEL bant YUKSEK olan dosya sayısı — "şu an en kritik sayı".
  highRiskCount Int
  /// GENEL skorların tam sayı ortalaması (dosya yoksa null).
  avgGenelScore Int?
  /// Bant dağılımı: { DUSUK, ORTA, YUKSEK } sayıları (JSON).
  bandDistributionJson String
  /// En riskli 5 dosya: [{ caseId, fileNumber, title, genel }] (JSON).
  topCasesJson String
  /// Bu fotoğrafta skor satırı YENİDEN hesaplanan dosya sayısı (iş telemetrisi).
  recomputedCount Int
  createdAt DateTime @default(now())

  @@unique([tenantId, date])
}

// ---------- Rakip Analizi Özellikleri (docs/faz2/rakip-analizi.md) ----------

/// AAÜT vekalet ücreti tarifesi — YILLIK, büro tarafından girilir (D7).
///
/// VERİ SÖZLEŞMESİ: NomosOS tarife RAKAMLARINI üretmez/uydurmaz — AAÜT her yıl
/// Resmî Gazete ile yayımlanır; avukat yıllık rakamları bu tabloya girer
/// (yönetim负担 bilinçli: yılda bir, beş dakika). Motor (packages/legal-core
/// vekalet-ucreti.ts) girilen tarifeden hesaplar.
model VekaletTarife {
  id        String   @id @default(uuid())
  tenantId  String
  yil       Int
  /// MAKTI kademeleri (AAÜT m.1): [{"limitKurus":"20000000","ucretKurus":"3700000"},…]
  /// Son kademenin limit'i null → üst sınır yok. Kuruş cinsinden string (para
  /// hassasiyeti: JS float ASLA kullanılmaz).
  maktuKademelerJson String
  /// Tekrarlı dilim (AAÜT m.1 son cümlesi): eşik üzeri her `birimKurus` için
  /// `ucretKurus`. Yoksa null. {"esikKurus":"20000000","birimKurus":"1000000","ucretKurus":"300000"}
  maktuTekrarJson    String?
  /// Nispi oran (AAÜT m.2): yüzde, örn. "16.50".
  nispiOranYuzde     Decimal @db.Decimal(5, 2)
  /// KDV oranı (serbest meslek faaliyeti KDV'ye tabi), yüzde.
  kdvOrani           Decimal @db.Decimal(4, 2) @default(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, yil])
}

/// TANITIM SİTESİ DEMO TALEBİ — platform yönetim panelinde izlenir.
///
/// İletişim KANALI DEĞİLDİR: talep e-posta/webhook GÖNDERİLMEZ; kayıt olarak
/// düşer ve platform panelinden (Demo Talepleri) takip edilir. Kullanıcının
/// verdiği iletişim bilgisi yalnız bu kayıtta durur — satış ekibi panelden arar.
model DemoRequest {
  id          String   @id @default(uuid())
  fullName    String
  barAssociation String?
  email       String
  phone       String?
  lawyerCount String?
  message     String?
  /// YENI | ILETISIME_GECILDI | KAPANDI
  status      String   @default("YENI")
  /// Durumu değiştiren platform kullanıcısı (iz).
  statusChangedBy String?
  statusChangedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

/// Portal ödeme bağlantısı (E8): fatura için tek kullanımlık, token'lı ödeme
/// adresi. Token URL'de taşınır; kimlik İSTEMEZ — bağlantıya sahip olan öder
/// (talep sahibi müvekkildir). Ödeme sağlayıcı soyutlaması Noop'tur:
/// yapılandırılmadıysa ödeme alınamaz, dürüst 503 döner.
model OdemeLinki {
  id        String   @id @default(uuid())
  tenantId  String
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Rastgele URL token'ı (32 bayt hex) — tek kullanımlık ödeme adresi.
  token     String   @unique
  amount    Decimal  @db.Decimal(18, 2)
  currency  String   @default("TRY")
  /// AKTIF | ODENDI | IPTAL
  status    String   @default("AKTIF")
  expiresAt DateTime?
  paidAt    DateTime?
  /// Ödeme gerçekleşince yazılan tahsilat kaydının kimliği (Payment.id).
  paidPaymentId String?
  createdAt DateTime @default(now())

  @@index([tenantId, invoiceId])
}

/// Randevu (E9): büro ajandası + müvekkil portal self-servisi.
/// Çakışma kapısı serviste: aynı büroda zaman aralığı ÇAKIŞAN randevu
/// oluşturulamaz (409).
model Randevu {
  id        String   @id @default(uuid())
  tenantId  String
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Portal üzerinden alındıysa portal kullanıcı kimliği.
  portalUserId String?
  title     String
  startAt   DateTime
  endAt     DateTime
  /// PLANLANDI | IPTAL | TAMAMLANDI
  status    String   @default("PLANLANDI")
  note      String?
  /// Büro tarafından açıldıysa açan kullanıcı.
  createdBy String?
  createdAt DateTime @default(now())

  @@index([tenantId, startAt])
  @@index([tenantId, status])
}

/// Avukatın elle bant geçersiz kılması. GEREKÇE ZORUNLUDUR — gerekçesiz
/// override, risk motorunu sessizce kapatmanın yoludur.
model RiskOverride {
  id        String        @id @default(uuid())
  tenantId  String
  caseId    String
  dimension RiskDimension
  band      RiskBand
  reason    String // ZORUNLU
  createdBy String // User id
  createdAt DateTime      @default(now())
  /// null = süresiz. Dolduğunda hesaplanan bant yeniden geçerli olur.
  expiresAt DateTime?

  @@index([tenantId, caseId, dimension])
  @@index([caseId, createdAt])
}

// ===========================================================================
// FAZ 4 — D) DELİL YÖNETİMİ (docs/moduller/14-delil-yonetimi.md)
// ===========================================================================
// İddia × Delil matrisi: hangi vakıayı hangi delil taşıyor, hangisi boşta.

enum ClaimSide {
  BIZ
  KARSI_TARAF
}

enum ClaimStatus {
  ACIK
  DESTEKLENIYOR
  ZAYIF
  CURUTULDU
}

/// İddia / vakıa — matrisin satırı. Karşı tarafın iddiaları da izlenir.
model Claim {
  id         String      @id @default(uuid())
  tenantId   String
  caseId     String
  case       Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  side       ClaimSide
  text       String
  orderIndex Int         @default(0)
  status     ClaimStatus @default(ACIK)
  createdBy  String // User id
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  evidenceLinks ClaimEvidenceLink[]
  legalBases    ClaimLegalBasis[]

  @@index([tenantId, caseId])
  @@index([caseId, side, orderIndex])
}

enum EvidenceType {
  BELGE
  FOTOGRAF
  VIDEO
  SES
  TANIK
  BILIRKISI
  KESIF
  DIGER
}

enum EvidenceStatus {
  PLANLANAN /// Toplanacak — delil boşluğu raporunun kaynağı
  TOPLANDI
  SUNULDU
  KABUL
  RED
}

/// Delil — matrisin sütunu.
/// Delilin KİM TARAFINDAN sunulduğu (F2 · E6 kalanı — Modül 14 KK6).
///
/// `offeredBy` olmadan "kendi sunduğumuz delil kendi iddiamızı çürütüyor"
/// tutarsızlığı (KK6) YAPISAL olarak yakalanamıyordu.
enum EvidenceSide {
  /// Delili BİZ sunduk (dava dosyamızda yer alıyor).
  BIZ
  /// Delili KARŞI TARAF sundu.
  KARSI_TARAF
  /// Delil mahkemece/bilirkişince dosyaya girdi ya da taraf belirsiz.
  ORTAK
}

model Evidence {
  id          String         @id @default(uuid())
  tenantId    String
  caseId      String
  case        Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type        EvidenceType
  title       String
  description String?
  /// Bağlı belge (Document.id). İlişki kurulmaz: belge silinse de delil
  /// kaydının kendisi (ve matristeki yeri) korunmalıdır.
  documentId  String?
  witnessName String? // TANIK tipinde
  obtainedAt  DateTime?
  status      EvidenceStatus @default(PLANLANAN)
  /// Delili KİM sundu (F2 · E6): BİZ sunduğumuz delili kendi iddiamıza
  /// ÇÜRÜTÜCÜ bağlamayız — KK6 kapısı bunu 422 ile reddeder.
  /// null = eski kayıt; eski deliller "bizim dosyamızda" varsayılır.
  offeredBy   EvidenceSide?
  createdBy   String // User id
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  claimLinks ClaimEvidenceLink[]

  @@index([tenantId, caseId])
  @@index([caseId, status])
  @@index([documentId])
}

/// Delil ile iddia arasındaki bağın YÖNÜ (denetim bulgusu Ö-30).
///
/// Modül 14'ün ana vaadi "karşı tarafın hangi delili hangi iddiamızı çürütüyor"
/// sorusuna cevap vermektir; bu ayrım olmadan matris yalnız "ne kadar destekliyor"
/// diyebiliyordu. KK3 ("hiç SUPPORTS bağı olmayan iddia unsupported=true") ve KK6
/// (kendi sunduğumuz delil kendi iddiamızı CONTRADICTS ediyorsa 422) yapısal
/// olarak uygulanamıyordu.
enum EvidenceLinkType {
  /// Delil iddiayı DESTEKLER.
  SUPPORTS
  /// Delil iddiayı ÇÜRÜTÜR.
  CONTRADICTS
  /// Delil iddiayla ilgilidir ama yönü belirsizdir (avukat henüz karar vermemiş).
  BELIRSIZ
}

/// Matrisin HÜCRESİ: bu delil bu iddiayı ne kadar taşıyor.
model ClaimEvidenceLink {
  id         String   @id @default(uuid())
  tenantId   String
  claimId    String
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  /// Bağın yönü. Varsayılan SUPPORTS: göç öncesindeki tüm satırlar "destekliyor"
  /// anlamında kurulmuştu (o zaman başka bir seçenek yoktu).
  linkType   EvidenceLinkType @default(SUPPORTS)
  /// Destek gücü 1-5 — AVUKAT değerlendirmesi (AI önerse de avukat onaylar).
  strength   Int?
  note       String?
  createdBy  String // User id
  createdAt  DateTime @default(now())

  @@unique([claimId, evidenceId])
  @@index([tenantId, claimId])
  @@index([evidenceId])
}

/// İddianın hukuki dayanağı. `reference` serbest metindir ("TBK m.112");
/// içtihat dayanağı verildiğinde `caseLawId` KAYIT ÜZERİNDEN doğrulanır.
model ClaimLegalBasis {
  id        String   @id @default(uuid())
  tenantId  String
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  reference String // Örn. "TBK m.112", "Yarg. 15. HD 2019/1234 E."
  /// CaseLawDocument.id — skaler. İçtihat havuzu kiracıdan bağımsız olduğu için
  /// FK kurulmaz; doğrulama caselaw modülünde kayıt aramasıyla yapılır.
  caseLawId String?
  note      String?
  createdAt DateTime @default(now())

  @@index([tenantId, claimId])
  @@index([caseLawId])
}

// ===========================================================================
// FAZ 4 — E) BİLİRKİŞİ (docs/moduller/13-bilirkisi.md)
// ===========================================================================

/// Bilirkişi kişi kaydı — büro içi hafıza ("bu bilirkişiyle daha önce ne oldu").
model Expert {
  id          String   @id @default(uuid())
  tenantId    String
  fullName    String
  specialty   String? // Örn. "İnşaat Yüksek Mühendisi"
  institution String?
  note        String? // Büro içi değerlendirme
  createdAt   DateTime @default(now())

  @@index([tenantId, fullName])
}

enum ExpertReportType {
  ASIL
  EK
  UZMAN_MUTALAASI /// Taraf uzman görüşü (HMK m.293)
}

/// Bilirkişi raporu. `servedAt` (TEBLİĞ) itiraz süresini tetikleyen tarihtir;
/// süre hesabı DETERMİNİSTİK motorda yapılır, burada saklanmaz.
model ExpertReport {
  id             String           @id @default(uuid())
  tenantId       String
  caseId         String
  case           Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Expert.id — skaler; bilirkişi kaydı silinse de rapor korunur.
  expertId       String?
  reportType     ExpertReportType @default(ASIL)
  /// Document.id — rapor belgesi (OCR'lı).
  documentId     String?
  receivedAt     DateTime
  /// Tebliğ tarihi — itiraz süresinin TETİKLEYİCİSİ.
  servedAt       DateTime?
  summary        String? // AI teknik özeti — avukat onaylı
  conclusionText String? // Raporun sonuç bölümü (aynen)
  createdBy      String // User id
  createdAt      DateTime         @default(now())

  objections ExpertObjection[]

  @@index([tenantId, caseId])
  @@index([caseId, receivedAt])
}

enum ObjectionStatus {
  TASLAK
  SUNULDU
  KABUL
  RED
}

/// Rapora itiraz. `points` madde listesidir; dilekçeye aktarım
/// `petitionId` ile izlenir, süre kaydı `deadlineId` ile bağlanır.
model ExpertObjection {
  id             String          @id @default(uuid())
  tenantId       String
  expertReportId String
  expertReport   ExpertReport    @relation(fields: [expertReportId], references: [id], onDelete: Cascade)
  /// Petition.id — skaler (itiraz dilekçesi ayrı yaşam döngüsüne sahiptir).
  petitionId     String?
  /// İtiraz maddeleri (JSON): [{ no, topic, summary, sourceRef? }]
  points         String
  status         ObjectionStatus @default(TASLAK)
  /// Deadline.id — hesaplanan itiraz süresi kaydı (skaler).
  deadlineId     String?
  createdBy      String // User id
  createdAt      DateTime        @default(now())

  @@index([tenantId, expertReportId])
  @@index([petitionId])
  @@index([deadlineId])
}

/// İki rapor arasındaki fark analizi (asıl ↔ ek rapor). AI ÜRETİR, ÖNERİDİR.
model ExpertReportDiff {
  id              String   @id @default(uuid())
  tenantId        String
  caseId          String
  baseReportId    String // ExpertReport.id
  compareReportId String // ExpertReport.id
  /// Fark özeti (JSON): [{ topic, before, after, changeType, significance }]
  diffJson        String
  model           String?
  createdAt       DateTime @default(now())

  @@index([tenantId, caseId, createdAt])
  @@index([baseReportId, compareReportId])
}

// ===========================================================================
// FAZ 4 — F) ÇATIŞMA KONTROLÜ (docs/moduller/11-conflict-check.md)
// ===========================================================================
// AĞIRLIKLI DETERMİNİSTİK: eşleşmeler kayıt taramasından çıkar (Client,
// CaseParty). AI yalnız "bağlı şirket olabilir" gibi çıkarım ekler ve
// kararı VERMEZ — kararı PARTNER/ADMIN verir, gerekçesiyle.

enum ConflictResult {
  TEMIZ
  DIKKAT
  CAKISMA
}

enum ConflictDecision {
  DEVAM
  REDDEDILDI
  BEKLEMEDE
}

model ConflictCheck {
  id           String            @id @default(uuid())
  tenantId     String
  query        String // Aranan ad/unvan (girildiği hali)
  context      String? // Hangi iş için tarandı (dava konusu, sektör)
  result       ConflictResult
  hitCount     Int               @default(0)
  decidedBy    String? // User id — PARTNER/ADMIN
  decision     ConflictDecision?
  decisionNote String?
  createdBy    String // User id
  createdAt    DateTime          @default(now())

  hits ConflictHit[]

  @@index([tenantId, createdAt])
  @@index([tenantId, result])
}

enum ConflictMatchType {
  MEVCUT_MUVEKKIL
  KARSI_TARAF
  ESKI_MUVEKKIL
  BAGLI_SIRKET
  DOSYADA_GECEN
  BENZER_AD
}

model ConflictHit {
  id              String            @id @default(uuid())
  conflictCheckId String
  conflictCheck   ConflictCheck     @relation(fields: [conflictCheckId], references: [id], onDelete: Cascade)
  matchType       ConflictMatchType
  entityType      String // "Client" | "CaseParty" | "Case"
  entityId        String?
  matchedName     String
  /// 0.0 - 1.0 benzerlik. Skor bir SIRALAMA aracıdır, karar değildir.
  similarity      Float
  /// AÇIK dosyadaki karşı taraf eşleşmesi — benzerlik CAKISMA eşiğinin altında
  /// kalsa bile sonucu ÇAKIŞMA'ya yükseltir (Modül 11, iş kuralı 4).
  /// AYRI ALAN OLARAK SAKLANIR: karar mantığı `note` cümlesinin içinden
  /// okunursa, kayıt geri yüklendiğinde çakışmanın hangi satırdan geldiği
  /// yapısal olarak kaybolur.
  escalated       Boolean           @default(false)
  caseId          String? // Eşleşmenin geçtiği dosya (skaler)
  note            String?

  @@index([conflictCheckId])
  @@index([caseId])
}

// ===========================================================================
// MODÜL 26 — AI KOTA VE KREDİ SİSTEMİ (docs/moduller/26-ai-kota-kredi-sistemi.md)
// ===========================================================================
// İLKE: kullanıcıya token değil KREDİ satılır. Kota dolduğunda YALNIZCA kredili
// AI işlemleri durur; dosya/duruşma/süre/görev/belge akışları ÇALIŞMAYA DEVAM
// EDER. BYO-LLM tenant'ında kredi kontrolü hiç devreye girmez.

/// Tenant kredi cüzdanı.
/// kullanılabilir = (includedCredits − includedConsumed) + purchasedCredits − reservedCredits
model CreditWallet {
  id       String @id @default(uuid())
  tenantId String @unique

  /// Abonelik dönemi (UTC gün başı).
  periodStart DateTime
  periodEnd   DateTime

  /// Dönem başında tahsis edilen dahil kota. DEVRETMEZ — dönem sonunda sıfırlanır.
  includedCredits  Int
  includedConsumed Int       @default(0)
  /// Satın alınan bakiye — DEVREDER, süresi dolmaz. Tüketim sırası: önce dahil kota.
  purchasedCredits Int       @default(0)
  /// Devam eden çağrılar için rezerve. Eşzamanlı isteklerin bakiyeyi negatife
  /// düşürmesini önler (kabul kriteri 2).
  reservedCredits  Int       @default(0)
  /// Rezervasyon sayacının 0'dan yukarı çıktığı an. Süreç çağrı ortasında
  /// ölürse (deploy, OOM, kill) `settle`/`release` hiç çalışmaz ve rezerve
  /// kredi KALICI olarak kilitlenirdi; süpürücü bu damgaya bakarak sahipsiz
  /// rezervasyonu serbest bırakır. Sayaç sıfırlandığında null'a döner.
  reservedSince    DateTime?

  /// CreditPackage.key — null = otomatik yükleme KAPALI (varsayılan).
  autoTopUpPackageKey String?

  /// Belge hattı kotası — sınıflandırma/çıkarma ücretsizdir, adetle sınırlanır.
  documentQuota Int
  documentUsed  Int @default(0)

  updatedAt DateTime @updatedAt
}

enum CreditTxType {
  TAHSIS /// Dönem başı dahil kota tahsisi
  TUKETIM /// Negatif amount
  SATIN_ALMA
  IADE /// Başarısız çağrı / rezervasyon iadesi
  DUZELTME /// Platform tarafı manuel düzeltme (dört-göz)
  SURESI_DOLDU /// Dönem sonunda sıfırlanan dahil kota
}

/// Hareket defteri — APPEND-ONLY. `balanceAfter` mutabakat testinin dayanağıdır:
/// hareketlerin toplamı ile cüzdan bakiyesi her zaman tutmalıdır.
model CreditTransaction {
  id       String       @id @default(uuid())
  tenantId String
  userId   String?
  type     CreditTxType
  /// Tüketimde NEGATİF, tahsis/satın almada pozitif.
  amount   Int

  taskType     String? // Hangi AI görevi
  caseId       String? // İzlenebilirlik (skaler)
  aiUsageLogId String? // AiUsageLog.id — maliyet/marj eşleştirmesi (skaler)

  /// Hareketten SONRAKİ kullanılabilir bakiye — denetim için.
  balanceAfter Int
  note         String?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([aiUsageLogId])
}

/// Görev başına kredi fiyat listesi. PLATFORM PANELİNDEN değiştirilir —
/// ücretsiz liste KODA GÖMÜLMEZ, `isFree` alanından okunur (iş kuralı 3).
model AiTaskCost {
  id          String   @id @default(uuid())
  taskType    String   @unique
  credits     Int
  isFree      Boolean  @default(false)
  description String?
  updatedBy   String? // PlatformUser id
  updatedAt   DateTime @updatedAt
}

/// İÇ MALİYET tablosu — kullanıcıya gösterilmez. Geçmiş fiyatlar KORUNUR;
/// fiyat değişikliği geriye dönük uygulanmaz (iş kuralı 10).
model ModelPrice {
  id               String         @id @default(uuid())
  providerType     AiProviderType
  model            String
  inputPricePer1M  Decimal        @db.Decimal(12, 4)
  outputPricePer1M Decimal        @db.Decimal(12, 4)
  currency         String         @default("USD")
  effectiveFrom    DateTime

  @@unique([providerType, model, effectiveFrom])
  @@index([providerType, model, effectiveFrom])
}

/// Satın alınabilir ek kredi paketi. Fiyat bir İŞ KARARIDIR; panelden güncellenir.
model CreditPackage {
  id       String  @id @default(uuid())
  key      String  @unique // "EK_500" | "EK_2000" | "EK_10000"
  credits  Int
  price    Decimal @db.Decimal(18, 2)
  currency String  @default("TRY")
  isActive Boolean @default(true)
}

/// Satılabilir ek disk paketi — CreditPackage desenini izler.
model DiskPackage {
  id       String  @id @default(uuid())
  key      String  @unique // "DISK_10GB" | "DISK_50GB" | "DISK_100GB"
  gb       Int
  price    Decimal @db.Decimal(18, 2)
  currency String  @default("TRY")
  isActive Boolean @default(true)
}

// ===========================================================================
// YARGI ORGANLARI + NOTERLER — referans veri kataloğu (kullanıcı talebi:
// "icra dairesini elle girmesin, listeden seçsin").
//
// Kaynak hiyerarşisi: SEED (kurulumdaki katalog) → SYNC (yapılandırılmış
// kaynaktan periyodik güncelleme) → MANUAL (panelde elle düzeltme).
// Liste yaklaşıklardır; bağlam sayısı/daire sayıları değişebilir — panelden
// düzeltilebilir ve senkron kaynağı tanımlıysa periyodik güncellenir.
// ===========================================================================

/// Mahkeme veya icra dairesi — il/ilçe bazında kategorize.
model JudicialBody {
  id       String   @id @default(uuid())
  /// MAHKEME | ICRA_DAIRESI
  type     String
  /// Mahkeme kategorisi: ASLIYE_HUKUK, ASLIYE_CEZA, SULH_HUKUK, SULH_CEZA,
  /// IS, AILE, TUKETICI, KADASTRO, ICRA_HUKUK, FIKRI_SINAI, ISTINAF.
  /// İcra dairelerinde "ICRA".
  category String
  /// Tam ad, örn. "İstanbul (Bakırköy) 3. Asliye Hukuk Mahkemesi".
  name     String
  il       String
  ilce     String?
  isActive Boolean  @default(true)
  /// SEED | SYNC | MANUAL
  source   String   @default("SEED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, name])
  @@index([type, category, il])
  @@index([il, ilce])
}

/// Noterlik — vekaletname kaydında listeden seçilir.
model NotaryOffice {
  id        String   @id @default(uuid())
  /// Tam ad, örn. "İstanbul (Bakırköy) 5. Noterliği".
  name      String
  il        String
  ilce      String?
  isActive  Boolean  @default(true)
  /// SEED | SYNC | MANUAL
  source    String   @default("SEED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([il, ilce])
}

/// Katalog senkron günlüğü — periyodik/elle senkron denemeleri kayıt altında.
model JudicialSyncLog {
  id          String   @id @default(uuid())
  /// MAHKEME | ICRA | NOTER | TUMU
  kind        String
  /// BASARILI | BASARISIZ | ATLANDI (kaynak yapılandırılmamış)
  status      String
  added       Int      @default(0)
  updated     Int      @default(0)
  detail      String?
  /// Tetikleyen: PlatformUser id veya "zamanlayici".
  triggeredBy String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ===========================================================================
// FAZ 5 — DIŞ YÜZ: MÜVEKKİL PORTALI · İLETİŞİM MERKEZİ · SÖZLEŞME/E-İMZA
// ===========================================================================
// ÜÇLÜ KİMLİK AYRIMI: User (büro) · PlatformUser (platform) · PortalUser (müvekkil).
// Üç tablo, üç JWT `aud` değeri, üç ayrı kapı. Bir tarafın token'ı diğerinde
// ASLA geçerli değildir — bu ayrım sunucuda zorunludur (Modül 10, iş kuralı 1).
//
// YAYIN KONTROLÜ: portal, büro verisinin aynası DEĞİLDİR. Müvekkil yalnızca
// PortalPublication ile AÇIKÇA yayınlanmış kaydı görür (allow-list). Yayın
// kaydı olmayan kaynak portal sorgusuna HİÇ GİRMEZ (deny-list değil).

// ---------- A) Müvekkil portalı (docs/moduller/10-muvekkil-portali.md) ----------

/// Portalda yayınlanabilen kaynak türleri. Liste KAPALIDIR: strateji, risk
/// skoru, iç görev, dosya notu ve simülasyon çıktısı burada YOKTUR ve portala
/// asla çıkamaz.
enum PortalResourceType {
  DOSYA
  BELGE
  DURUSMA
  SAFAHAT_KAYDI
  FATURA
  MESAJ
  ODEME
}

/// Portal kullanıcısı — büro `User` tablosundan TAMAMEN AYRI.
/// Bir müvekkile (tüzel kişide şirkete) birden çok portal kullanıcısı bağlanabilir.
model PortalUser {
  id           String  @id @default(uuid())
  tenantId     String
  clientId     String
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  fullName     String
  /// Vekalet ilişkisi bittiğinde / azil kaydında false'a çekilir; mevcut
  /// oturumlar da geçersizleşir (uygulama katmanı).
  isActive     Boolean @default(true)

  lastLoginAt DateTime?
  /// Daveti gönderen büro kullanıcısı (User.id) — skaler, davet eden kullanıcı
  /// silinse bile portal hesabı ayakta kalmalıdır.
  invitedBy   String?
  invitedAt   DateTime?
  activatedAt DateTime?

  /// ── HESAP KİLİDİ (KALICI) ────────────────────────────────────────────────
  /// Bellek içi sayaç süreç yeniden başlayınca sıfırlanıyordu ve çok örnekli
  /// dağıtımda örnek başına tutuluyordu. Sayaç artık kaydın kendisindedir:
  /// kilit sürecin ömründen ve örnek sayısından BAĞIMSIZDIR.
  failedAttempts      Int       @default(0)
  /// Sayaç penceresinin bittiği an — bu andan sonra birikmemiş hatalar unutulur.
  failureWindowEndsAt DateTime?
  /// Kilidin bittiği an. null / geçmiş = kilit yok.
  lockedUntil         DateTime?

  /// ── OTURUM İPTALİ ────────────────────────────────────────────────────────
  /// Bu andan ÖNCE üretilmiş portal token'ları geçersizdir. Çıkış (logout),
  /// parola sıfırlama ve hesabın pasifleştirilmesi bu damgayı tazeler; böylece
  /// ortak bilgisayardan çıkan müvekkilin token'ı 8 saat boyunca yaşamaz.
  sessionsValidFrom DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([clientId])
  @@index([tenantId, isActive])
  @@index([email])
}

/// Portal daveti. HAM TOKEN SAKLANMAZ — yalnız SHA-256 özeti tutulur; e-postaya
/// giden ham değer bir daha üretilemez (veritabanı sızıntısı hesabı açmaz).
model PortalInvite {
  id        String    @id @default(uuid())
  tenantId  String
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String // SHA-256(hex) — ham token ASLA yazılmaz
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String // User id
  createdAt DateTime  @default(now())

  @@index([tenantId, expiresAt])
  @@index([clientId])
  @@index([tokenHash])
}

/// AÇIK YAYIN LİSTESİ — portal görünürlüğünün TEK kaynağı (allow-list).
/// `unpublishedAt` dolu kayıt yayından kaldırılmıştır; portal sorgusu
/// `unpublishedAt: null` süzgeci olmadan ÇALIŞTIRILMAZ.
model PortalPublication {
  id                String             @id @default(uuid())
  tenantId          String
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  resourceType      PortalResourceType
  /// Kaynak kaydın id'si — çok biçimli (polymorphic), İLİŞKİ KURULMAZ.
  resourceId        String
  publishedBy       String // User id — yayın kararının sorumlusu
  publishedAt       DateTime           @default(now())
  /// Yayından kaldırma anı. null = yayında.
  unpublishedAt     DateTime?
  /// ── SAHİPLİK İKİNCİ AYAĞI ────────────────────────────────────────────────
  /// Portal görünürlüğü normalde İKİ bağımsız koşula dayanır: açık yayın kararı
  /// VE kaydın gerçekten bu müvekkile ait olması. Bazı kaynaklarda sahiplik
  /// çözülemez (ör. hiçbir dosyaya bağlanmamış belge) ve karar YALNIZCA avukatın
  /// tıklamasına iner. Bu bayrak o tekil kararları görünür kılar: `false` ise
  /// kaydın ikinci kapısı KAPANMAMIŞTIR, yalnızca atlanmıştır.
  ownershipVerified Boolean            @default(true)
  /// Avukatın yayın notu / müvekkile gösterilen sade açıklama. SAFAHAT_KAYDI
  /// yayınında AI durum özetinin ONAYLANMIŞ metni burada DONDURULUR: kaynak
  /// kayıt sonradan değişse bile müvekkilin gördüğü metin sabit kalır.
  note              String?

  @@unique([tenantId, resourceType, resourceId, clientId])
  @@index([tenantId, clientId, resourceType])
  @@index([tenantId, unpublishedAt])
}

/// Portal denetim izi — giriş, belge indirme, görüntüleme. Büro AuditLog'undan
/// ayrıdır; müvekkilin ne gördüğü KVKK açısından ayrıca ispatlanabilir olmalıdır.
model PortalAuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  /// PortalUser.id — skaler: hesap silinse bile denetim izi korunur.
  portalUserId String
  action       String // "PORTAL_LOGIN" | "PORTAL_DOCUMENT_DOWNLOAD" | ...
  resourceType String?
  resourceId   String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([portalUserId, createdAt])
}

// ---------- B) İletişim merkezi (docs/moduller/19-iletisim-merkezi.md) ----------

enum CommDirection {
  GELEN
  GIDEN
}

enum CommChannel {
  EPOSTA
  SMS
  WHATSAPP
  TELEFON
  PORTAL
  YUZ_YUZE
  DIGER
}

/// Giden mesaj durum makinesi. GONDERILDI'ye YALNIZCA ONAYLANDI üzerinden
/// geçilir; `approvedBy` boşken gönderim 409 ile reddedilir (iş kuralı 1).
enum OutboundStatus {
  TASLAK
  ONAY_BEKLIYOR
  ONAYLANDI
  GONDERILDI
  BASARISIZ
  IPTAL
}

/// Gelen mesajın dosyayla eşleştirilme durumu. ESLESTI'ye geçiş İNSAN ONAYI
/// ister; AI önerisi tek başına caseId yazmaz (iş kuralı 5).
enum MatchStatus {
  BEKLIYOR
  ESLESTI
  ELLE_ESLESTI
  ESLESMEDI
}

/// Birleşik iletişim geçmişi — kanal fark etmeksizin her yazışmanın tek
/// zaman çizelgesi. Telefon görüşmesi de elle buraya not edilir.
model CommunicationLog {
  id                String        @id @default(uuid())
  tenantId          String
  clientId          String?
  client            Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  caseId            String?
  case              Case?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  direction         CommDirection
  channel           CommChannel
  subject           String?
  body              String
  /// Karşı tarafın adresi: e-posta / telefon numarası. KVKK anonimleştirme
  /// talebinde `body` ile birlikte temizlenir, kayıt iskeleti korunur.
  contactRef        String?
  occurredAt        DateTime
  /// Kaydı giren büro kullanıcısı (User.id) — gelen mesajda null olabilir.
  recordedBy        String?
  /// ── KAYNAK AYRIMI ────────────────────────────────────────────────────────
  /// "SISTEM" = onay makinesinden geçip GERÇEKTEN gönderilmiş mesaj (aşağıdaki
  /// outboundMessageId doludur). "ELLE" = büro kullanıcısının kendi eliyle
  /// düştüğü not ("telefonda söyledim"). İkisi ayırt edilemezse "müvekkile ne
  /// söylendi, kim onayladı?" sorusu tek tablodan cevaplanamaz.
  source            String?       @default("ELLE")
  /// Kaydı doğuran giden mesaj (OutboundMessage.id) — skaler. Onaylayanın
  /// kimliği o kayıttaki `approvedBy` alanındadır.
  outboundMessageId String?
  createdAt         DateTime      @default(now())

  @@index([tenantId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([caseId, occurredAt])
  @@index([tenantId, channel, occurredAt])
  @@index([outboundMessageId])
}

/// Mesaj şablonu. tenantId null = SİSTEM şablonu (tüm kiracılara açık, salt okunur).
/// Gövde {{muvekkilAdi}}, {{dosyaNo}}, {{durusmaTarihi}} gibi yer tutucular içerir;
/// çözülemeyen değişken kalırsa taslak onaya DÜŞMEZ (iş kuralı 9).
model MessageTemplate {
  id       String      @id @default(uuid())
  tenantId String?
  key      String // Örn. "SISTEM_DURUSMA_HATIRLATMA"
  name     String
  channel  CommChannel
  subject  String?
  body     String
  isSystem Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outboundMessages OutboundMessage[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([channel])
}

/// Giden mesaj — İNSAN ONAYININ TAŞIYICISI.
/// AI/şablon taslağı `draftBody`'de, onaylanan metin `finalBody`'de durur:
/// "AI ne önerdi" ile "ne gönderildi" her zaman ayrıştırılabilir (iş kuralı 3).
model OutboundMessage {
  id          String           @id @default(uuid())
  tenantId    String
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  caseId      String?
  case        Case?            @relation(fields: [caseId], references: [id], onDelete: SetNull)
  channel     CommChannel
  templateId  String?
  template    MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subject     String?
  /// AI veya şablon çıktısı — DEĞİŞTİRİLMEZ, onay ekranında diff'in solu.
  draftBody   String
  /// Avukatın onayladığı nihai metin. Gönderilen METİN BUDUR.
  finalBody   String?
  status      OutboundStatus   @default(TASLAK)
  /// Gönderim ÖNCESİ KVKK taraması sonucu (packages/ai scanPii çıktısı, JSON).
  /// Üçüncü kişi TCKN'si / sağlık verisi tespitinde onay ekranı engelleyici
  /// uyarı gösterir; "yine de gönder" kararı AuditLog'a gerekçeyle yazılır.
  piiScanJson String?

  createdBy     String // User id — taslağı hazırlayan
  /// ONAYLAYAN kullanıcı (User.id). BU ALAN DOLMADAN GÖNDERİM YAPILAMAZ.
  approvedBy    String?
  approvedAt    DateTime?
  sentAt        DateTime?
  /// Sağlayıcı mesaj id'si (idempotency + durum geri bildirimi eşleştirmesi).
  providerRef   String?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([clientId, createdAt])
  @@index([caseId])
  @@index([tenantId, providerRef])
}

/// Gelen mesaj — webhook/e-posta kutusu girişi. Müvekkil ve dosya eşleştirmesi
/// ayrı bir hattır: `matchConfidence` AI önerisidir, `matchStatus` insan kararıdır.
model InboundMessage {
  id         String      @id @default(uuid())
  tenantId   String
  channel    CommChannel
  /// Gönderenin adresi (e-posta / telefon) — müvekkil eşleştirmesinin girdisi.
  fromRef    String
  subject    String?
  body       String
  receivedAt DateTime

  clientId        String?
  client          Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  caseId          String?
  case            Case?       @relation(fields: [caseId], references: [id], onDelete: SetNull)
  /// MESSAGE_CASE_MATCH güven skoru 0..1. >=0.80 öneri ön-seçili gelir,
  /// <0.50 hiç gösterilmez — ama HER İKİ HALDE de insan onayı gerekir.
  /// (Eşikler: inbound-match.ts — motorun kuralıdır.)
  matchConfidence Float?
  matchStatus     MatchStatus @default(BEKLIYOR)
  /// Eşleştirmeyi onaylayan büro kullanıcısı (User.id).
  processedBy     String?

  createdAt DateTime @default(now())

  @@index([tenantId, receivedAt])
  @@index([tenantId, matchStatus, receivedAt])
  @@index([clientId])
  @@index([caseId])
}

// ---------- D) Sözleşme + e-imza (docs/moduller/20-sozlesme-eimza.md) ----------

enum ContractType {
  VEKALET_UCRET
  DANISMANLIK
  GIZLILIK
  HIZMET
  DIGER
}

enum ContractStatus {
  TASLAK
  MUZAKERE
  IMZAYA_HAZIR
  IMZADA
  YURURLUKTE
  SONA_ERDI
  FESIH
}

/// E-imza süreci durumu. GERÇEK SAĞLAYICI KİMLİK BİLGİSİ YOKTUR: çekirdek
/// yalnız bu soyutlamayı bilir, sağlayıcı adaptörü yapılandırılmamışsa
/// "yapılandırılmamış" hatası döner — sahte entegrasyon UYDURULMAZ.
enum SignatureStatus {
  OLUSTURULDU
  GONDERILDI
  IMZALANDI
  REDDEDILDI
  SURESI_DOLDU
  IPTAL
}

model Contract {
  id               String         @id @default(uuid())
  tenantId         String
  clientId         String?
  client           Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  caseId           String?
  case             Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  title            String
  type             ContractType
  status           ContractStatus @default(TASLAK)
  /// Aktif sürüm (ContractVersion.id) — ilişki kurulmaz, döngüyü önlemek için
  /// skaler (Petition/PetitionVersion ile aynı desen).
  currentVersionId String?

  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  /// Fesih ihbar süresi (gün). Süre Motoru bu değerden `Deadline` üretir —
  /// hesap DETERMİNİSTİKTİR, @nomosos/legal-core ile yapılır.
  renewalNoticeDays Int?
  /// Kendiliğinden yenileme hükmü var mı.
  autoRenew         Boolean   @default(false)

  createdBy String // User id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions          ContractVersion[]
  signatureRequests SignatureRequest[]

  @@index([tenantId, status])
  @@index([tenantId, effectiveTo])
  @@index([clientId])
  @@index([caseId])
}

/// Sözleşme sürümü — DEĞİŞTİRİLEMEZ (immutable). Her müzakere turu yeni sürümdür;
/// sürümler arası fark bu metinler üzerinden hesaplanır.
model ContractVersion {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionNo   Int
  /// Düz metin — diff ve CONTRACT_REVIEW girdisi.
  contentText String
  /// Kaynak belge (Document.id) — skaler, belge silinse bile metin korunur.
  documentId  String?
  changeNote  String?
  createdBy   String // User id
  createdAt   DateTime @default(now())

  signatureRequests SignatureRequest[]

  @@unique([contractId, versionNo])
  @@index([contractId, createdAt])
}

/// E-imza talebi — SAĞLAYICI-BAĞIMSIZ. `provider` bir adaptör anahtarıdır
/// ("noop" = yapılandırılmamış). İmzacı listesi JSON'da tutulur:
/// [{ name, email?, phone?, order, status, signedAt? }]
model SignatureRequest {
  id          String          @id @default(uuid())
  tenantId    String
  contractId  String
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionId   String
  version     ContractVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String?
  status      SignatureStatus @default(OLUSTURULDU)
  signersJson String

  sentAt           DateTime?
  completedAt      DateTime?
  /// İmzalı nüsha (Document.id) — skaler.
  signedDocumentId String?
  failureReason    String?

  createdBy String // User id
  createdAt DateTime @default(now())

  @@index([tenantId, status])
  @@index([contractId])
  @@index([versionId])
  @@index([tenantId, providerRef])
}

// ---------- Faz 6) Raporlama + zamanlanmış işler + bildirim kuyruğu ----------
// docs/moduller/18-partner-dashboard.md · 25-sistem-yonetim-paneli.md · docs/06-yol-haritasi.md (Faz 6)
//
// TEMEL İLKE: raporlar DETERMİNİSTİKTİR. Buradaki modeller rapor TANIMINI,
// ÇALIŞTIRMA KAYDINI ve İŞ GÜNLÜĞÜNÜ tutar; RAKAM TUTMAZ. Rakamlar her
// çalıştırmada veritabanından yeniden üretilir — önbelleğe alınmış bir sayı
// "rapor sonucu" diye saklanmaz ki eski veri doğruymuş gibi sunulmasın.

/// Kayıtlı raporun görünürlüğü. KISISEL yalnız oluşturana, BURO tenant
/// genelinde herkese görünür (rol kısıtları AYRICA sunucuda uygulanır:
/// STAJYER finans raporlarını, SEKRETER kârlılık/verimlilik raporlarını
/// göremez — BURO kapsamı bu kısıtı GEÇERSİZ KILMAZ).
enum ReportScope {
  KISISEL
  BURO
}

/// Raporun hangi biçimde üretildiği (denetim izi).
enum ReportFormat {
  EKRAN
  CSV
  PDF
}

/// Zamanlanmış iş / iş çalıştırması durumu.
/// ATLANDI: iş çalıştı ama idempotentlik gereği yapacak bir şey bulamadı
/// (aynı gün ikinci kez tetiklendi) — BAŞARISIZ değildir.
enum JobStatus {
  BASARILI
  BASARISIZ
  CALISIYOR
  ATLANDI
}

/// Bildirim türü. Her tür, kaynağını (süre/duruşma/görev/kredi/sözleşme/vekalet)
/// dedupeKey içinde taşır; kuyruk aynı olay için ikinci kaydı ÜRETEMEZ.
enum NotificationKind {
  SURE_YAKLASIYOR
  SURE_GECTI
  DURUSMA_YARIN
  GOREV_ATANDI
  ONAY_BEKLIYOR
  KREDI_AZALDI
  SOZLESME_YENILEME
  VEKALET_SURESI
}

enum NotificationStatus {
  BEKLIYOR
  GONDERILDI
  OKUNDU
  IPTAL
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/// Kullanıcının kaydettiği rapor tanımı (rapor + filtre kümesi).
/// SONUÇ SAKLAMAZ — yalnız "hangi rapor, hangi parametrelerle" bilgisidir;
/// açıldığında rakamlar yeniden hesaplanır.
model SavedReport {
  id         String @id @default(uuid())
  tenantId   String
  name       String
  /// Rapor anahtarı — raporlama modülündeki tanımlı rapora karşılık gelir
  /// (örn "buro-aylik-ozet", "avukat-is-yuku", "tahsilat-yaslandirma").
  reportKey  String
  /// Filtreler (JSON metin): dönem, kullanıcı, müvekkil, dosya türü vb.
  /// Dönem alanları kapanış tarihinin DAHİL mi HARİÇ mi olduğunu açıkça taşır.
  paramsJson String

  scope     ReportScope @default(KISISEL)
  createdBy String // User id
  /// Panelde üste sabitlenmiş mi.
  isPinned  Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, scope])
  @@index([tenantId, reportKey])
  @@index([tenantId, createdBy])
}

/// Rapor çalıştırma kaydı — DENETİM amaçlıdır (kim, hangi raporu, ne zaman,
/// hangi filtreyle, hangi biçimde çalıştırdı). Append-only; rapor ÇIKTISI
/// burada tutulmaz, yalnız satır sayısı ve süre ölçüsü tutulur.
model ReportRun {
  id         String @id @default(uuid())
  tenantId   String
  reportKey  String
  paramsJson String

  /// Üretilen satır sayısı (ölçüm; sonucun kendisi değil).
  rowCount   Int?
  durationMs Int?
  format     ReportFormat @default(EKRAN)

  runBy     String // User id
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, reportKey, createdAt])
  @@index([tenantId, runBy, createdAt])
}

/// Zamanlanmış iş TANIMI (BullMQ tekrarlayan işine karşılık gelir).
/// Kayıt SİSTEM GENELİDİR (tenantId yok): iş tüm kiracılar üzerinde dolaşır,
/// kiracı bazlı sonuç `JobRun.tenantId` ile ayrışır.
model ScheduledJob {
  id   String @id @default(uuid())
  /// Kod tarafındaki değişmez anahtar (örn "usage-snapshot-daily").
  key  String @unique
  name String

  /// Cron ifadesi (5 alan). Sunucu saat dilimi işi kuran tarafta sabitlenir.
  cronExpression String
  isEnabled      Boolean @default(true)

  lastRunAt      DateTime?
  lastStatus     JobStatus?
  lastError      String?
  lastDurationMs Int?
  nextRunAt      DateTime?

  updatedAt DateTime @updatedAt

  @@index([isEnabled, nextRunAt])
}

/// İş çalıştırma günlüğü — APPEND-ONLY. `ScheduledJob.last*` alanları bu
/// günlüğün özetidir; çelişki halinde KAYNAK BU TABLODUR.
model JobRun {
  id       String  @id @default(uuid())
  /// ScheduledJob.key — skaler; iş tanımı silinse bile günlük korunur.
  jobKey   String
  /// Kiracı bazlı işlerde hangi kiracı için çalıştığı; genel işlerde null.
  ///
  /// BUGÜN TANIMLI OLAN BÜTÜN İŞLER KİRACILAR ARASIDIR (süre/duruşma
  /// hatırlatmaları, kullanım fotoğrafı, abonelik ve kredi denetimi hepsi tüm
  /// kiracıları tek koşuda dolaşır), dolayısıyla bu alan HER SATIRDA null'dur
  /// ve indeks kullanılmaz. Alan ve indeks bilerek bırakıldı: ileride tek
  /// kiracıya özel bir iş (ör. bir büronun toplu içe aktarımı) eklendiğinde
  /// şema değişikliği gerekmesin. "Hangi büro etkilendi" sorusunun bugünkü
  /// yanıtı `detailJson` içindeki kırılımdır (denetim bulgusu 12).
  tenantId String?

  status     JobStatus
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// İşlenen kayıt sayısı (idempotentlik denetimi için: ikinci çalıştırma 0 olmalı).
  itemsProcessed Int?
  errorMessage   String?
  /// Serbest biçimli ayrıntı (JSON metin) — atlanan kayıtlar, kırılım vb.
  detailJson     String?

  @@index([jobKey, startedAt])
  @@index([tenantId, startedAt])
  @@index([status, startedAt])
}

/// Bildirim giden kutusu. Bildirim ÜRETİMİ ile GÖNDERİMİ ayrılır: zamanlanmış
/// iş yalnız BEKLIYOR kaydı yazar, gönderim kanalı sonra işler.
///
/// IDEMPOTENTLİK: @@unique([tenantId, dedupeKey]) — dedupeKey olayın kimliğidir
/// (örn "SURE_YAKLASIYOR:<deadlineId>:3g"). Aynı gün ikinci kez çalışan iş
/// unique ihlali alır ve kaydı ATLAR; müvekkile/avukata çift bildirim GİTMEZ.
model NotificationOutbox {
  id       String  @id @default(uuid())
  tenantId String
  /// Alıcı (User id). Boş ise büro geneli duyurudur.
  userId   String?

  kind  NotificationKind
  title String
  body  String

  /// İlgili kaynak (örn "Deadline" / "Hearing" / "Task") ve kimliği — skaler,
  /// kaynak silinse bile bildirim geçmişi bozulmaz.
  resourceType String?
  resourceId   String?

  /// Olay kimliği — idempotentlik anahtarı. ÜRETİCİ İŞ TARAFINDAN belirlenir.
  dedupeKey String

  status       NotificationStatus @default(BEKLIYOR)
  /// Ne zaman gönderilmeli (ileri tarihli bildirim); boşsa ilk turda gönderilir.
  scheduledFor DateTime?
  sentAt       DateTime?
  readAt       DateTime?

  createdAt DateTime @default(now())

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, userId, status])
  @@index([tenantId, kind, createdAt])
}

/// Mobil/tarayıcı bildirim jetonu. Jeton CİHAZA aittir; aynı jeton başka
/// kullanıcıya geçerse (cihaz devri, çıkış-giriş) kayıt GÜNCELLENİR —
/// bu yüzden @@unique([token]) tenant'tan bağımsızdır ve bir cihaz iki
/// kiracıya aynı anda bildirim alamaz.
model DeviceToken {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  platform   DevicePlatform
  token      String
  isActive   Boolean        @default(true)
  lastSeenAt DateTime?

  createdAt DateTime @default(now())

  @@unique([token])
  @@index([tenantId, userId, isActive])
}
