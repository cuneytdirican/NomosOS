{
  "name": "@nomosos/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "migrate:dev": "node scripts/with-root-env.mjs prisma migrate dev",
    "migrate:deploy": "node scripts/with-root-env.mjs prisma migrate deploy",
    "migrate:status": "node scripts/with-root-env.mjs prisma migrate status",
    "seed": "node scripts/with-root-env.mjs tsx src/seed.ts",
    "studio": "node scripts/with-root-env.mjs prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "@nomosos/legal-core": "workspace:*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^7.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
